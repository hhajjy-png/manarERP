{
  "name": "manar-erp",
  "productName": "Al Manar ERP",
  "version": "2026.5.2",
  "private": true,
  "description": "نظام إدارة أعمال شركة المنار — Electron + React + Express + Prisma + SQLite (الكويت)",
  "author": "شركة المنار الدولية",
  "main": "electron-dist/main.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "echo 'بعد التثبيت: npm run db:generate ثم npm run db:migrate ثم npm run db:seed'",
    "db:generate": "npm --workspace backend run prisma:generate",
    "db:migrate": "npm --workspace backend run prisma:migrate",
    "db:seed": "npm --workspace backend run prisma:seed",
    "electron:build": "tsc -p electron/tsconfig.json",
    "test:electron": "vitest run -c vitest.electron.config.ts",
    "dev:front": "npm --workspace frontend run dev",
    "predev:electron": "npm run electron:build",
    "dev:electron": "wait-on tcp:5173 && node scripts/start-electron.cjs",
    "dev": "concurrently -k -n FRONT,APP -c blue,green \"npm run dev:front\" \"npm run dev:electron\"",
    "build:back": "npm --workspace backend run build",
    "build:front": "npm --workspace frontend run build",
    "package:backend-deps": "node scripts/prepare-backend-deps.js",
    "package:seed-data": "node scripts/prepare-seed-data.js",
    "package:analyze-deps": "node scripts/analyze-runtime-deps.js",
    "package:nsis-prereqs": "node scripts/generate-nsis-prereqs.js",
    "package:repair-cache": "node scripts/repair-builder-cache.js",
    "cleanup:dev": "node scripts/cleanup-dev-artifacts.js",
    "dist": "npm run build:back && npm run build:front && npm run electron:build && npm run package:backend-deps && npm run package:seed-data && npm run package:analyze-deps && npm run package:nsis-prereqs && npm run package:repair-cache && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "google-auth-library": "^9.14.1",
    "node-cron": "^3.0.3"
  }
}
