// ════════════════════════════════════════════════════════════════════════
//  نظام إدارة أعمال شركة المنار — مخطط قاعدة البيانات (Prisma + SQLite)
//  ملاحظة: SQLite لا يدعم الـ enum في Prisma، لذلك تُستخدم حقول String
//          مع توثيق القيم المسموحة، ويُفرض التحقق منها في طبقة Zod.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  المصادقة والصلاحيات (Auth & RBAC)
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String // bcrypt
  fullName     String
  email        String?   @unique
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  // ربط اختياري بسجل الموظف
  employeeId Int?      @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  auditLogs           AuditLog[]
  backups             Backup[]
  approvalHistories   ApprovalHistory[]
  uploadedAttachments Attachment[]      @relation("AttachmentUploader")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique // SYSTEM_ADMIN, GENERAL_MANAGER, ACCOUNTANT...
  displayName String // الاسم العربي المعروض
  description String?
  isSystem    Boolean @default(false) // أدوار النظام لا تُحذف

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique // مثال: invoices.create, equipment.delete
  module      String // invoices, equipment, contracts...
  action      String // create, read, update, delete, approve
  description String?

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
//  العملاء (Customers)
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id          Int     @id @default(autoincrement())
  code        String  @unique // رقم العميل
  name        String
  nameEn      String? // الاسم بالإنجليزي (اختياري)
  type        String  @default("PRIVATE") // GOVERNMENT | PRIVATE
  category    String? // تصنيف العميل
  phone       String?
  email       String?
  address     String?
  contactName String? // اسم المسؤول
  notes       String?
  isArchived  Boolean @default(false)

  contracts     Contract[]
  invoices      Invoice[]
  projectPrices ProjectPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isArchived])
  @@index([isArchived, type])
  @@index([name])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────
//  الموظفون والموارد البشرية (Employees / HR)
// ─────────────────────────────────────────────────────────────────────────

model Employee {
  id                   Int       @id @default(autoincrement())
  code                 String    @unique // الرقم الوظيفي
  fullName             String // اسم الموظف (بالعربي)
  fullNameEn           String? // اسم الموظف (بالإنجليزي)
  civilId              String? // الرقم المدني
  jobTitle             String? // المهنة
  nationality          String? // الجنسية
  passportNumber       String? // رقم جواز السفر
  passportExpiry       DateTime? // تاريخ انتهاء جواز السفر
  residencyExpiry      DateTime? // تاريخ انتهاء الإقامة
  licenseExpiry        DateTime? // تاريخ انتهاء رخصة القيادة
  vehiclePlate         String? // رقم لوحة المركبة
  vehicleLicenseExpiry DateTime? // تاريخ انتهاء رخصة المركبة
  birthDate            DateTime? // تاريخ الميلاد
  company              String? // الشركة
  department           String? // القسم
  salary               Float     @default(0) // الراتب الشهري
  hireDate             DateTime?
  phone                String?
  email                String?
  address              String? // العنوان
  photoPath            String? // مسار صورة الموظف
  bankAccount          String? // رقم الحساب البنكي (للتطابق في استيراد الرواتب)
  status               String    @default("ACTIVE") // ACTIVE | ON_LEAVE | TERMINATED
  notes                String?

  user                User?
  attendance          Attendance[]
  payrolls            Payroll[]
  recurringAllowances EmployeeAllowance[]
  recurringDeductions EmployeeRecurringDeduction[]
  advances            PayrollAdvance[]
  leaves              Leave[]
  leaveSettlements    LeaveSettlement[]
  entitlementLedger   EmployeeEntitlementLedger[]
  finalSettlements    EmployeeFinalSettlement[]
  deductions          Deduction[]
  bonuses             Bonus[]
  // مستحقات الموظف الشهرية (وحدة مستقلة) — حقل علاقة عكسي **فقط**، تفرضه Prisma لكل
  // علاقة. لا عمود جديد في جدول `employees`، ولا تغيير في أي حقل أو سلوك قائم.
  compensationCalcs   EmployeeCompensationCalculation[]
  // سجل المديونيات والسلف (نفس الوحدة المستقلة) — حقل علاقة عكسي فقط، بلا عمود جديد.
  compensationDebts   EmployeeCompensationDebt[]
  performanceRevs     PerformanceReview[]
  approvedExpenses    Expense[]                    @relation("ExpenseApprover")
  managedContracts    Contract[]                   @relation("ContractManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([status])
  @@index([civilId])
  @@index([bankAccount])
  @@index([residencyExpiry])
  @@index([passportExpiry])
  @@index([licenseExpiry])
  @@map("employees")
}

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT") // PRESENT | ABSENT | LATE | LEAVE
  workHours  Float?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

model Leave {
  id         Int      @id @default(autoincrement())
  employeeId Int
  type       String // ANNUAL | SICK | UNPAID | EMERGENCY
  startDate  DateTime
  endDate    DateTime
  days       Int
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reason     String?

  /// تاريخ العودة المتوقَّع — بيانات **طلب** الإجازة الإداري، لا مدخلًا لأي احتساب.
  /// كان الحقل الوحيد في نموذج طلب الإجازة المطبوع بلا أي تخزين: يُكتب في الصفحة عند
  /// كل طباعة ويضيع بعدها، فلا يمكن إعادة طباعة الطلب نفسه لاحقًا. اختياري لأن كل
  /// سجلّات الإجازة السابقة أُنشئت بدونه، ولأنه ليس شرطًا لاعتماد الإجازة.
  /// لا يمسّ محرّك المستحقات إطلاقًا — ذاك يقرأ النوع والتواريخ والحالة وحدها.
  expectedReturnDate DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

// عطلات رسمية — الحد الأدنى من البنية التحتية اللازمة لاستثناء العطلات الرسمية من عدّ
// أيام الإجازة السنوية المستهلكة عند وقوعها داخل فترة إجازة سنوية معتمدة (المادة 70،
// قانون العمل الكويتي 6/2010). لا علاقة لها بإعادة تصميم وحدة الإجازات (Leave) — قراءة
// فقط من محرك احتساب الاستحقاقات (entitlements.calc.ts).
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      String
  notes     String?
  createdAt DateTime @default(now())

  @@index([date])
  @@map("holidays")
}

// دفعات مقدَّمة يدوية على رصيد الإجازة — سجل تاريخي/توثيقي فقط. ليست وحدة محاسبية، ولا
// ترتبط بقيود اليومية أو التحويلات البنكية أو الشيكات أو سندات الصرف أو الرواتب.
// إعادة تصميم قانوني (المادتان 73/74 — لا يجوز إسقاط استحقاق الإجازة بمقابل أثناء
// الخدمة): لم يعد أي صف هنا يُنشئ أو يُزيح خط أساس احتساب رصيد الإجازة — الرصيد يتراكم
// دومًا من تاريخ التعيين بلا انقطاع (entitlements.calc.ts). البيانات هنا للتوثيق
// التاريخي فقط ولا تُقرأ إطلاقًا كمدخل لأي احتساب.
model LeaveSettlement {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  settlementDate   DateTime
  leaveDaysSettled Float    @default(0)
  settlementAmount Float    @default(0)
  paymentMethod    String // CASH | BANK_TRANSFER | CHEQUE | OTHER
  notes            String?
  createdAt        DateTime @default(now())
  createdBy        Int? // معرّف المستخدم الذي سجّل التسوية (تسجيل فقط، بلا علاقة FK)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([settlementDate])
  @@map("leave_settlements")
}

// سجل المستحقات المصروفة — سجل تاريخي للمراجعة فقط. مستقلٌّ تمامًا عن LeaveSettlement:
// لا يؤثر في أي احتساب (رصيد الإجازة/بدل الإجازة/مكافأة نهاية الخدمة)، ولا ينشئ قيودًا
// محاسبية أو حركات بنكية أو شيكات أو سندات أو رواتب. تسجيل يدوي بحت.
model EmployeeEntitlementLedger {
  id                   Int      @id @default(autoincrement())
  employeeId           Int
  entryType            String // LEAVE_ALLOWANCE | END_OF_SERVICE | OTHER
  entryDate            DateTime
  description          String?
  leaveDays            Float? // يُخزَّن لبدل الإجازة فقط
  // لقطة رصيد الإجازة المحتسَب لحظة إنشاء الصف (لبدل الإجازة فقط). للعرض التاريخي فقط —
  // تُكتب مرة واحدة عند الإنشاء، لا تتحدّث تلقائيًا، ولا تدخل في أي احتساب إطلاقًا.
  leaveBalanceSnapshot Float?
  amount               Float    @default(0)
  paymentMethod        String // CASH | BANK_TRANSFER | CHEQUE | OTHER
  notes                String?
  createdAt            DateTime @default(now())
  createdBy            Int? // معرّف المستخدم الذي سجّل الصف (تسجيل فقط، بلا علاقة FK)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([entryDate])
  @@map("employee_entitlement_ledger")
}

// ════════════════════════════════════════════════════════════════════════════
// التصفية النهائية للموظف (Employee Final Settlement v1)
//
// سجل مستقل تمامًا داخل نطاق «مستحقات الموظف»: ليس راتبًا ولا قيدًا محاسبيًا، ولا ينشئ
// أي أثر في الرواتب أو الحسابات أو البنوك أو الشيكات. يتكوّن حصريًا من مكوّنَين:
// (١) متبقي القيمة النقدية لرصيد الإجازة، و(٢) مكافأة نهاية الخدمة. لا بدلات ولا مكافآت
// ولا إضافات/خصومات يدوية.
//
// دورة الحياة: DRAFT (يُعاد احتسابه حيًّا) ← APPROVED (لقطة مجمَّدة) ← PAID (سُدِّد بالكامل).
// حقول اللقطة أدناه فارغة في المسودة، وتُكتب مرة واحدة عند الاعتماد فقط، ولا تُحدَّث بعدها
// مهما تغيّرت بيانات الموظف — فالنتيجة المعتمدة قابلة لإعادة الشرح والتدقيق لاحقًا.
//
// ═══ قيد «تصفية نشطة واحدة» ═══
// القاعدة: للموظف تصفية **نشطة** واحدة فقط (DRAFT | APPROVED | PAID)، مع عدد غير محدود من
// التصفيات **الملغاة** التاريخية. لا يعبّر عن ذلك `@@unique([employeeId])` (فهو يمنع التاريخ
// أصلًا)، والفهرس الجزئي (Partial Unique Index) غير مدعوم في صياغة Prisma حتى الآن — لذلك
// يُنشأ يدويًا في الترحيل:
//     CREATE UNIQUE INDEX ... ON employee_final_settlements(employeeId) WHERE status <> 'CANCELLED'
// انظر ترحيل 20260729140000_final_settlement_cancellation. الفهرس العادي أدناه هو ما تعرفه
// Prisma؛ القيد الفريد الجزئي يعيش في قاعدة البيانات ويحرس الثبات حتى أمام طلبين متزامنين.
model EmployeeFinalSettlement {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  status            String   @default("DRAFT") // DRAFT | APPROVED | PAID | CANCELLED
  lastWorkingDay    DateTime // تاريخ الاحتساب المعتمد للتصفية (تقويمي)
  terminationReason String // RESIGNATION | EMPLOYER_TERMINATION

  // ── لقطة الاعتماد المجمَّدة (كلها null في المسودة) ─────────────────────────────
  approvedAt               DateTime?
  approvedBy               Int? // معرّف المستخدم المعتمِد (تسجيل فقط، بلا علاقة FK)
  snapshotHireDate         DateTime?
  snapshotSalaryUsed       Float? // Employee.salary وقت الاعتماد (المصدر الوحيد)
  snapshotDailyWage        Float?
  snapshotWageDivisor      Int? // قاسم الأجر اليومي المعتمد وقت الاعتماد (26)
  snapshotServiceYears     Float?
  snapshotServiceMonths    Int?
  snapshotServiceDays      Int?
  snapshotServiceTotalDays Int?
  snapshotLeaveDays        Float? // رصيد أيام الإجازة عند تاريخ التصفية
  snapshotLeaveValue       Float? // القيمة النقدية لرصيد الإجازة قبل خصم المدفوع سابقًا
  snapshotPriorLeavePaid   Float? // إجمالي دفعات بدل الإجازة السابقة المنطبقة
  snapshotLeaveRemaining   Float? // مكوّن الإجازة في التصفية = القيمة − المدفوع سابقًا
  snapshotEosScenario      String? // RESIGNATION | EMPLOYER_TERMINATION
  snapshotEosFullAmount    Float? // المكافأة الكاملة (المادة 51) قبل نسبة الاستقالة
  snapshotEosFraction      Float? // نسبة الاستقالة المطبَّقة (المادة 53) — 1 عند الإنهاء
  snapshotEosAmount        Float? // مكوّن نهاية الخدمة في التصفية
  snapshotTotalAmount      Float? // إجمالي التصفية = مكوّن الإجازة + مكوّن نهاية الخدمة

  // ── الإلغاء (حالة نهائية) — لا حذف للسجل ولا مساس باللقطة المجمَّدة ────────────
  cancelledAt        DateTime?
  cancelledBy        Int? // معرّف المستخدم المُلغي (تسجيل فقط، بلا علاقة FK)
  cancellationReason String?

  employee Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments FinalSettlementPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?

  @@index([employeeId])
  @@index([status])
  @@map("employee_final_settlements")
}

// دفعات التصفية النهائية — منفصلة صراحةً عن سجل دفعات المستحقات العادية
// (EmployeeEntitlementLedger) حتى لا تختلط الدفعات السابقة للتصفية بدفعات التصفية نفسها.
// المدفوع/المتبقي يُشتقّان دائمًا من هذه الصفوف مقابل إجمالي اللقطة المجمَّدة — لا رصيد
// متبقٍّ مُخزَّن قابل للتحرير.
model FinalSettlementPayment {
  id            Int      @id @default(autoincrement())
  settlementId  Int
  paymentDate   DateTime
  amount        Float
  paymentMethod String // CASH | BANK_TRANSFER | CHEQUE | OTHER
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  createdBy     Int?

  settlement EmployeeFinalSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([paymentDate])
  @@map("final_settlement_payments")
}

model Deduction {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Float
  reason     String?
  date       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("deductions")
}

model Bonus {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Float
  reason     String?
  date       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("bonuses")
}

model Payroll {
  id                      Int       @id @default(autoincrement())
  employeeId              Int
  month                   Int // 1-12
  year                    Int
  baseSalary              Float
  snapshotBaseSalary      Float     @default(0)
  regularWorkDays         Int       @default(0)
  presentDays             Int       @default(0)
  absentDays              Int       @default(0)
  leaveDays               Int       @default(0)
  lateDays                Int       @default(0)
  regularHours            Float     @default(0)
  actualHours             Float     @default(0)
  overtimeHours           Float     @default(0)
  overtimeRate            Float     @default(0)
  overtimeAmount          Float     @default(0)
  totalBonus              Float     @default(0)
  totalAllowances         Float     @default(0)
  /// Deprecated: kept for backward compatibility. Use totalDeductions for new payroll calculations.
  totalDeduction          Float     @default(0)
  totalDeductions         Float     @default(0)
  totalAdvances           Float     @default(0)
  grossSalary             Float     @default(0)
  netSalary               Float
  status                  String    @default("DRAFT") // DRAFT | APPROVED | PAID | CANCELLED
  approvedAt              DateTime?
  approvedById            Int?
  paidAt                  DateTime?
  paidById                Int?
  paymentMethod           String?
  accountingPostedAt      DateTime?
  accountingTransactionId Int?
  notes                   String?

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    PayrollLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([year, month])
  @@index([employeeId])
  @@index([status])
  @@index([accountingTransactionId])
  @@map("payroll")
}

model PayrollLine {
  id         Int     @id @default(autoincrement())
  payrollId  Int
  employeeId Int
  type       String // BASE | ALLOWANCE | DEDUCTION | ADVANCE | OVERTIME | ATTENDANCE
  sourceType String? // EMPLOYEE | RECURRING_ALLOWANCE | RECURRING_DEDUCTION | ADVANCE | ATTENDANCE | MANUAL
  sourceId   Int?
  label      String
  amount     Float   @default(0)
  quantity   Float?
  rate       Float?
  notes      String?

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([payrollId])
  @@index([employeeId])
  @@index([type])
  @@index([sourceType, sourceId])
  @@map("payroll_lines")
}

model EmployeeAllowance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  name       String
  amount     Float
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([isActive])
  @@map("employee_allowances")
}

model EmployeeRecurringDeduction {
  id         Int       @id @default(autoincrement())
  employeeId Int
  name       String
  amount     Float
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([isActive])
  @@map("employee_recurring_deductions")
}

model PayrollAdvance {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  amount          Float
  remainingAmount Float
  date            DateTime @default(now())
  status          String   @default("OPEN") // OPEN | SETTLED | CANCELLED
  notes           String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@map("payroll_advances")
}

model PerformanceReview {
  id         Int      @id @default(autoincrement())
  employeeId Int
  period     String // مثال: 2026-Q1
  score      Float // 0-100
  reviewer   String?
  comments   String?
  date       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("performance_reviews")
}

// ─────────────────────────────────────────────────────────────────────────
//  المعدات والآليات (Equipment)
// ─────────────────────────────────────────────────────────────────────────

model Equipment {
  id                 Int       @id @default(autoincrement())
  code               String    @unique // رقم المعدة
  name               String? // اسم المعدة (اختياري)
  type               String // قلاب | شيول | حفار | مدحلة | رصاصة | معدة خفيفة
  ownerName          String? // اسم المالك
  driverName         String? // اسم السائق
  plateNumber        String? // رقم اللوحة
  chassisNumber      String? // رقم القاعدة (الشاصي)
  color              String? // اللون
  registrationExpiry DateTime? // تاريخ انتهاء دفتر المركبة
  insuranceExpiry    DateTime? // تاريخ انتهاء التأمين
  status             String    @default("WORKING") // WORKING (تعمل) | NOT_WORKING (لا تعمل)
  manufacturer       String?
  model              String?
  manufactureYear    Int?
  serialNumber       String?
  currentLocation    String?
  operatingHours     Float     @default(0)
  purchaseDate       DateTime?
  purchaseCost       Float?
  notes              String?

  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]
  breakdowns         Breakdown[]
  spareParts         SparePartUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([registrationExpiry])
  @@index([insuranceExpiry])
  @@map("equipment")
}

model MaintenanceRecord {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  type        String // PREVENTIVE | CORRECTIVE
  description String
  cost        Float     @default(0)
  performedBy String?
  date        DateTime
  nextDueDate DateTime? // موعد الصيانة الدورية القادمة
  status      String    @default("COMPLETED") // SCHEDULED | IN_PROGRESS | COMPLETED

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([equipmentId])
  @@index([nextDueDate])
  @@map("maintenance_records")
}

model FuelLog {
  id          Int      @id @default(autoincrement())
  equipmentId Int
  liters      Float
  cost        Float
  odometer    Float?
  date        DateTime @default(now())
  notes       String?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([date])
  @@map("fuel_logs")
}

model Breakdown {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  description String
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  severity    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String    @default("OPEN") // OPEN | RESOLVED

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@map("breakdowns")
}

model SparePartUsage {
  id          Int      @id @default(autoincrement())
  equipmentId Int
  partName    String
  quantity    Int      @default(1)
  unitCost    Float    @default(0)
  totalCost   Float    @default(0)
  date        DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@map("spare_part_usage")
}

// ─────────────────────────────────────────────────────────────────────────
//  العقود (Contracts) — عقود نقل الأسفلت الشهرية مع مصانع الأسفلت
// ─────────────────────────────────────────────────────────────────────────

model Contract {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique // رقم العقد
  asphaltPlant          String // اسم مصنع الأسفلت
  location              String? // مكان العقد
  monthlyTransportValue Float     @default(0) // قيمة نقل الأسفلت الشهري
  startDate             DateTime?
  endDate               DateTime?
  status                String    @default("ACTIVE") // ACTIVE | EXPIRED | RENEWING | SUSPENDED
  notes                 String?
  unitName              String? // وحدة العقد (مثل: درب، طن، متر)
  price                 Float? // سعر الوحدة
  companyName           String? // اسم الشركة المنفذة

  customerId Int? // الجهة المتعاقدة (اختياري)
  managerId  Int? // المسؤول عن العقد

  customer       Customer?          @relation(fields: [customerId], references: [id])
  manager        Employee?          @relation("ContractManager", fields: [managerId], references: [id])
  invoices       Invoice[]
  expenses       Expense[]
  documents      ContractDocument[]
  materialIssues MaterialIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("contracts")
}

model ContractDocument {
  id         Int      @id @default(autoincrement())
  contractId Int
  title      String
  filePath   String // مسار الملف/الصورة
  fileType   String? // image | pdf | doc
  uploadedAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_documents")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  entityType   String // CUSTOMER | CONTRACT | INVOICE | EMPLOYEE | SUPPLIER | EXPENSE | EQUIPMENT
  entityId     Int
  title        String
  fileName     String // stored filename (uuid prefix)
  originalName String // original upload filename
  filePath     String // مسار مطلق قديم — تشخيصي فقط؛ لا يُعتمد عليه (انظر `content`)
  fileSize     Int      @default(0) // bytes
  mimeType     String?
  uploadedById Int?
  uploadedAt   DateTime @default(now())

  // بايتات الملف نفسها — المصدر الوحيد للحقيقة منذ Zero Data Loss Certification Pack v1.
  //
  // لماذا داخل قاعدة البيانات لا بجوارها: وحدة النسخ الاحتياطي والمزامنة في هذا
  // المشروع هي ملف `manar.db` وحده (`backup.service.create` ينسخه، و`syncEngine`
  // يرفعه/ينزّله). كل ما يعيش خارجه لا يُنسَخ ولا يُزامَن ولا ينتقل إلى جهاز جديد.
  // كانت المرفقات تعيش على القرص فقط، فكانت الاستعادة تُنتج سجلّات مرفقات بلا ملفات
  // — فقدان بيانات صامت. وضع البايتات هنا يجعل المرفقات تَرِث تلقائيًا كل ضمانات
  // القاعدة (WAL checkpoint، sha256، الاستبدال الذرّي، حلّ التعارض، نسخة الإنقاذ)
  // بلا نظام تخزين ثانٍ يحتاج دلالات تعارض خاصة به.
  //
  // `Bytes?` لا `Bytes`: العمود مضاف لاحقًا على قواعد فيها صفوف قائمة، فيبدأ NULL
  // ويملؤه `backfillAttachmentContent()` عند الإقلاع من الملفات الموجودة على القرص.
  // أي صف يبقى NULL يعني أن ملفه فُقد قبل هذه الحزمة — لا يُخترع له محتوى.
  content Bytes?

  uploadedBy User? @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@index([uploadedAt])
  @@map("attachments")
}

// ─────────────────────────────────────────────────────────────────────────
//  الموردون (Suppliers)
// ─────────────────────────────────────────────────────────────────────────

model Supplier {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  nameEn      String? // الاسم بالإنجليزي (اختياري)
  phone       String?
  email       String?
  address     String?
  contactName String?
  notes       String?
  isArchived  Boolean @default(false)

  invoices       Invoice[]
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────
//  الفواتير (Invoices) — تشمل فواتير العملاء وفواتير الموردين
// ─────────────────────────────────────────────────────────────────────────

model Invoice {
  id               Int       @id @default(autoincrement())
  number           String    @unique // رقم الفاتورة
  invoiceNumber    String    @unique // الرقم اليدوي الكامل للفاتورة: MN-INV-2026-...
  direction        String    @default("SALES") // SALES (عميل) | PURCHASE (مورّد)
  invoiceType      String    @default("نقل اسفلت") // نقل اسفلت | يومية عمل مالينج | يومية نقل اسفلت
  customerId       Int?
  supplierId       Int?
  contractId       Int?
  issueDate        DateTime  @default(now())
  dueDate          DateTime?
  subtotal         Float     @default(0)
  taxRate          Float     @default(0) // نسبة الضريبة %
  taxAmount        Float     @default(0)
  discount         Float     @default(0)
  total            Float     @default(0)
  paidAmount       Float     @default(0)
  status           String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE | CANCELLED
  notes            String?
  verificationUuid String?   @unique
  billingMonth     Int? // شهر الحساب (1-12)
  billingYear      Int? // سنة الحساب (مثال: 2026)
  deliveryDate     DateTime? // تاريخ تسليم الفاتورة (متابعة داخلية — لا يظهر في الطباعة)
  paymentMethod    String? // GL routing: CASH | BANK | ACCOUNTS_PAYABLE — فواتير المشتريات فقط

  customer Customer?     @relation(fields: [customerId], references: [id])
  supplier Supplier?     @relation(fields: [supplierId], references: [id])
  contract Contract?     @relation(fields: [contractId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([direction])
  @@index([status])
  @@index([customerId])
  @@index([supplierId])
  @@index([contractId])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          Int    @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Float  @default(1)
  unit        String @default("طن") // طن | درب | يومية
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  priceId     Int? // FK to project_prices (nullable — immutable snapshot, set at creation)

  invoice Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  price   ProjectPrice? @relation(fields: [priceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([priceId])
  @@map("invoice_items")
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  amount    Float
  method    String   @default("CASH") // CASH | BANK | CHEQUE | TRANSFER
  date      DateTime @default(now()) // تاريخ التحصيل — official collection date (user-editable); drives GL entry date + all collection reports
  createdAt DateTime @default(now()) // system audit timestamp — when the payment was entered; never user-editable
  reference String?
  notes     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────
//  المصروفات (Expenses)
// ─────────────────────────────────────────────────────────────────────────

model Expense {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  category      String // قيمة نصية من ENUMS.expenseCategory (config/constants.ts) — لا enum على مستوى DB
  description   String
  amount        Float
  date          DateTime  @default(now())
  billingMonth  Int? // شهر الحساب (1-12)
  billingYear   Int? // سنة الحساب
  notes         String? // ملاحظات حرة
  contractId    Int?
  supplierId    Int?
  supplierName  String? // اسم مورد حر (عند عدم وجوده في قائمة الموردين)
  documentPath  String? // مستند مرفق
  paymentMethod String    @default("CASH") // CASH | BANK | ACCOUNTS_PAYABLE
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | REVERSED | CANCELLED
  approvedById  Int?
  approvedAt    DateTime?

  contract   Contract? @relation(fields: [contractId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  approvedBy Employee? @relation("ExpenseApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([status, date])
  @@index([contractId])
  @@index([date])
  @@index([billingMonth, billingYear])
  @@index([supplierId])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────
//  القيود المحاسبية (Transactions / Journal Entries)
// ─────────────────────────────────────────────────────────────────────────

model Transaction {
  id            Int      @id @default(autoincrement())
  entryNumber   String   @unique // رقم القيد
  date          DateTime @default(now())
  description   String
  type          String // REVENUE | EXPENSE | TRANSFER | ADJUSTMENT
  debit         Float    @default(0) // مدين
  credit        Float    @default(0) // دائن
  account       String // اسم/رمز الحساب
  referenceType String? // INVOICE | EXPENSE | PAYROLL | MANUAL
  referenceId   Int? // معرّف المستند المرتبط

  createdAt DateTime @default(now())

  @@index([date])
  @@index([type])
  @@index([account])
  @@index([referenceType, referenceId])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────
//  سجل التدقيق (Audit Log)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | RESTORE...
  module    String // الوحدة المتأثرة
  entityId  String? // معرّف السجل المتأثر
  oldValue  String? // JSON للقيم قبل التغيير
  newValue  String? // JSON للقيم بعد التغيير
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
//  سجل الاعتماد (Approval History) — تاريخ حالات الموافقة عبر الوحدات
// ─────────────────────────────────────────────────────────────────────────

model ApprovalHistory {
  id           Int     @id @default(autoincrement())
  entityType   String // 'expense' | 'payroll' | 'invoice' | future modules
  entityId     Int
  action       String // 'approve' | 'reject' | 'submit' | 'cancel' | 'reopen' | 'pay'
  fromStatus   String
  toStatus     String
  userId       Int? // null for system-initiated transitions
  comment      String?
  reason       String?
  metadataJson String? // JSON blob for future extensibility

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("approval_history")
}

// ─────────────────────────────────────────────────────────────────────────
//  النسخ الاحتياطي (Backups)
// ─────────────────────────────────────────────────────────────────────────

model Backup {
  id          Int      @id @default(autoincrement())
  fileName    String
  filePath    String
  sizeBytes   Int      @default(0)
  // MANUAL | AUTO | SCHEDULED | RESCUE
  // RESCUE = نسخة إنقاذ تلقائية بعد فشل عملية سحابية. تصنيف مستقلّ عن AUTO: لا يحكمه
  // إعداد النسخ التلقائي، ولا يُحدِّث حالته، وله حدّ احتفاظ خاص به.
  // عمود نصّي حرّ — إضافة القيمة لا تتطلب أي migration.
  type        String   @default("MANUAL")
  status      String   @default("SUCCESS") // SUCCESS | FAILED
  createdById Int?
  createdAt   DateTime @default(now())

  checksumSha256     String? // SHA-256 of the backup file (computed on verify)
  verifiedAt         DateTime? // timestamp of last verification
  verificationStatus String? // PASS | FAIL | PENDING
  verificationNote   String? // short error or info message

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([type])
  @@index([createdAt])
  @@map("backups")
}

// ─────────────────────────────────────────────────────────────────────────
//  دليل الحسابات (Chart of Accounts)
// ─────────────────────────────────────────────────────────────────────────

model Account {
  id            Int     @id @default(autoincrement())
  code          String  @unique // رمز الحساب (مثل: 1100)
  name          String // اسم الحساب
  nameEn        String? // اسم الحساب بالإنجليزي (اختياري)
  type          String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalBalance String  @default("DEBIT") // DEBIT | CREDIT
  isActive      Boolean @default(true)
  parentId      Int? // الحساب الرئيسي (للتسلسل الهرمي)
  notes         String?

  parent       Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]          @relation("AccountHierarchy")
  journalLines JournalEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("accounts")
}

// ─────────────────────────────────────────────────────────────────────────
//  قيود اليومية بالقيد المزدوج (Journal Entries — Double Entry)
// ─────────────────────────────────────────────────────────────────────────

model JournalEntry {
  id            Int      @id @default(autoincrement())
  entryNumber   String   @unique // رقم القيد (JRN-2026-00001)
  date          DateTime @default(now())
  description   String
  referenceType String? // INVOICE | EXPENSE | PAYROLL | SALARY_PAYMENT | MANUAL | *_REVERSAL
  referenceId   Int?
  status        String   @default("POSTED") // DRAFT | POSTED | CANCELLED

  // نسخة الترحيل — يبدأ من 1، ويتزايد عند كل تصحيح (عكس + إعادة ترحيل). دفتر غير قابل
  // للتغيير: القيد المُرحَّل لا يُحذف أبدًا؛ التعديل يُنشئ عكسًا للنسخة الحالية ثم يُرحّل
  // نسخة جديدة. مفتاح التفرّد يشمل `revision` كي تتعايش النسخ في الدفتر دون تعارض،
  // مع بقاء حماية الترحيل المزدوج (نسخة واحدة لكل (نوع، مرجع، رقم نسخة)).
  revision Int @default(1)

  lines JournalEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([referenceType, referenceId, revision]) // حماية ضد الترحيل المزدوج مع دعم النُسَخ التصحيحية (SQLite يعامل NULL كقيم متمايزة)
  @@index([date])
  @@index([status])
  @@index([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             Int     @id @default(autoincrement())
  journalEntryId Int
  accountId      Int
  description    String?
  debit          Float   @default(0)
  credit         Float   @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// ─────────────────────────────────────────────────────────────────────────
//  الإعدادات (Settings) — مخزن مفتاح/قيمة
// ─────────────────────────────────────────────────────────────────────────

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique // company.name, invoice.taxRate, backup.cron...
  value     String // مخزّنة كنص/JSON
  group     String   @default("general") // general | company | finance | backup
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

// ─────────────────────────────────────────────────────────────────────────
//  المستودع والمواد (Inventory)
// ─────────────────────────────────────────────────────────────────────────

model MaterialCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  nameEn      String? // الاسم بالإنجليزي (اختياري)
  description String?
  isActive    Boolean @default(true)

  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("material_categories")
}

model Material {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  nameEn       String? // الاسم بالإنجليزي (اختياري)
  categoryId   Int
  unit         String // طن | كيلو | لتر | قطعة | متر | كيس | برميل | صندوق
  unitCost     Float   @default(0)
  currentStock Float   @default(0)
  minimumStock Float   @default(0) // عتبة التنبيه عند انخفاض المخزون
  isActive     Boolean @default(true)
  notes        String?

  category           MaterialCategory    @relation(fields: [categoryId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  issueItems         MaterialIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@map("materials")
}

model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  number       String    @unique // PO-2026-00001
  supplierId   Int
  date         DateTime  @default(now())
  expectedDate DateTime?
  status       String    @default("DRAFT") // DRAFT | SUBMITTED | RECEIVED | CANCELLED
  notes        String?
  totalAmount  Float     @default(0)

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([date])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int   @id @default(autoincrement())
  purchaseOrderId Int
  materialId      Int
  quantity        Float
  unitCost        Float @default(0)
  totalCost       Float @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([purchaseOrderId])
  @@index([materialId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                      Int       @id @default(autoincrement())
  number                  String    @unique // GR-2026-00001
  purchaseOrderId         Int?
  supplierId              Int
  date                    DateTime  @default(now())
  status                  String    @default("DRAFT") // DRAFT | POSTED
  notes                   String?
  totalCost               Float     @default(0)
  accountingPostedAt      DateTime?
  accountingTransactionId Int? // references Transaction.id — prevents double posting

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  items         GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([date])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             Int   @id @default(autoincrement())
  goodsReceiptId Int
  materialId     Int
  quantity       Float
  unitCost       Float @default(0)
  totalCost      Float @default(0)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  material     Material     @relation(fields: [materialId], references: [id])

  @@index([goodsReceiptId])
  @@index([materialId])
  @@map("goods_receipt_items")
}

// ─────────────────────────────────────────────────────────────────────────
//  سندات الصرف (Material Issues) — صرف مواد للمشاريع/العقود
// ─────────────────────────────────────────────────────────────────────────

model MaterialIssue {
  id                      Int       @id @default(autoincrement())
  number                  String    @unique // MI-2026-00001
  contractId              Int?
  date                    DateTime  @default(now())
  status                  String    @default("DRAFT") // DRAFT | POSTED | CANCELLED
  notes                   String?
  totalCost               Float     @default(0)
  accountingPostedAt      DateTime?
  accountingTransactionId Int? // references Transaction.id — prevents double posting

  contract Contract?           @relation(fields: [contractId], references: [id])
  items    MaterialIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([status])
  @@index([date])
  @@map("material_issues")
}

model MaterialIssueItem {
  id               Int   @id @default(autoincrement())
  materialIssueId  Int
  materialId       Int
  quantity         Float
  unitCostSnapshot Float @default(0) // WAC snapshot at time of posting
  totalCost        Float @default(0)

  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([materialIssueId])
  @@index([materialId])
  @@map("material_issue_items")
}

// ─────────────────────────────────────────────────────────────────────────
//  الرواتب — عمليات صرف الرواتب (Salary Payments)
// ─────────────────────────────────────────────────────────────────────────

model SalaryPayment {
  id                 Int       @id @default(autoincrement())
  paymentDate        DateTime? // تاريخ الدفع
  sourceMonth        String? // شهر الاستحقاق (مثل Jun-25)
  transactionId      String    @unique // رقم العملية (مفتاح فريد)
  beneficiaryAccount String? // رقم حساب المستفيد
  beneficiaryName    String // اسم المستفيد
  bankName           String? // البنك
  amount             Float     @default(0) // المبلغ
  currency           String    @default("KWD") // العملة
  paymentType        String? // نوع الدفع
  status             String? // الحالة (PROCESSED ...)
  errorDescription   String? // وصف الخطأ
  civilId            String? // الرقم المدني
  duplicateFlag      String? // علامة التكرار

  createdAt DateTime @default(now())

  @@index([paymentDate])
  @@index([beneficiaryName])
  @@index([civilId])
  @@index([status])
  @@map("salary_payments")
}

// ─────────────────────────────────────────────────────────────────────────
//  استيراد كشف الحساب البنكي (Bank Statement Import)
// ─────────────────────────────────────────────────────────────────────────

model BankStatementImport {
  id           Int       @id @default(autoincrement())
  bankName     String // 'NBK' | 'KFH' | 'GulfBank' | 'Boubyan' | 'Warba' | 'AhliUnited' | 'Unknown'
  fileName     String
  importedBy   String
  importedAt   DateTime  @default(now())
  fromDate     DateTime?
  toDate       DateTime?
  totalRows    Int       @default(0)
  totalDebits  Float     @default(0)
  totalCredits Float     @default(0)
  status       String    @default("ACTIVE") // ACTIVE | ARCHIVED

  // Incremental import v2 — session report fields
  accountKey              String?
  insertedNewCount        Int     @default(0)
  skippedDuplicateCount   Int     @default(0)
  potentialDuplicateCount Int     @default(0)

  transactions BankStatementTransaction[]

  createdAt DateTime @default(now())
  // ‏@default(now()) يصف العمود كما هو فعلًا في قاعدة البيانات: المهاجرة اليدوية
  // 20260625100000 أنشأته بـ DEFAULT CURRENT_TIMESTAMP. بدون هذا الوصف يرى
  // `migrate dev` فرقًا دائمًا ويقترح إعادة بناء الجدول. لا أثر على السلوك —
  // Prisma تكتب updatedAt في كل عملية كتابة، والافتراضي يخدم الإدراج الخام وحده.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([bankName])
  @@index([status])
  @@index([importedAt])
  @@index([accountKey])
  @@map("bank_statement_imports")
}

model BankStatementTransaction {
  id       Int                 @id @default(autoincrement())
  importId Int
  import   BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  transactionId     String?
  bankName          String
  statementDate     DateTime?
  postingDate       DateTime?
  description       String    @default("")
  reference         String?
  debit             Float     @default(0)
  credit            Float     @default(0)
  balance           Float?
  // 1-based position of this row among the data rows of its own import file
  // (header rows excluded), in original file order. Row 1 = first data row =
  // newest transaction per the bank's official statement convention. Source
  // of truth for display order and "current balance" — not derived from
  // statementDate. Nullable for backward compatibility with rows imported
  // before this field existed; backfilled by migration.
  statementSequence Int?
  currency          String    @default("KWD")
  accountNumber     String?
  iban              String?
  chequeNumber      String?
  rawRow            String    @default("{}") // JSON
  normalizedText    String    @default("")

  // Reconciliation state
  reconcileStatus String  @default("UNMATCHED") // UNMATCHED | MATCHED | IGNORED | DUPLICATE | REVIEW
  matchedType     String? // 'invoice' | 'payment' | 'expense' | 'journal' | 'cheque' | 'payroll'
  matchedId       Int?
  matchedRef      String?
  matchConfidence Int? // 100 | 90 | 75 | 0

  // Flags
  isDuplicate Boolean @default(false)
  isBankFee   Boolean @default(false)
  bankFeeType String? // 'TRANSFER_FEE' | 'MONTHLY_FEE' | 'INTEREST' | 'CHARGE' | 'OTHER'
  errors      String  @default("[]") // JSON array
  warnings    String  @default("[]") // JSON array

  // Incremental import v2 — fingerprint fields
  accountKey             String? // Stable key: IBAN: | ACCT:<bank>:<acct> | BANK:<bank>
  transactionFingerprint String? // SHA-256 hash (first 32 hex chars) of key transaction fields

  createdAt DateTime @default(now())
  // ‏@default(now()) — انظر الشرح نفسه في BankStatementImport أعلاه.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([importId])
  @@index([reconcileStatus])
  @@index([transactionId])
  @@index([chequeNumber])
  @@index([statementDate])
  @@index([accountKey])
  @@index([accountKey, statementDate])
  @@index([accountKey, transactionFingerprint])
  @@index([importId, statementSequence])
  @@map("bank_statement_transactions")
}

// ─────────────────────────────────────────────────────────────────────────
//  الأسعار الثابتة للمشاريع (Project Prices)
// ─────────────────────────────────────────────────────────────────────────

model ProjectPrice {
  id                  Int           @id @default(autoincrement())
  asphaltPlant        String // مصنع الأسفلت
  companyName         String // اسم الشركة
  contractLocation    String // مكان العقد
  contractUnit        String // وحدة العقد: طن | درب | يومية
  unitPrice           Float // سعر الوحدة (د.ك) — سعر العميل
  // القيمة الافتراضية لما يُدفع لصاحب المعدة مقابل وحدة عمل واحدة (د.ك).
  //
  // حقل مرجعي بحت لا يدخل أي حساب مالي: الفواتير والمحاسبة والتقارير لا تقرؤه
  // إطلاقًا — يقرؤه «تحليل الشغل والعمولة» وحده ليملأ به الحقل تلقائيًا، ويظلّ
  // المحلِّل حرًّا في تجاوزه داخل تحليله دون أن يعود التجاوز إلى هنا.
  // الافتراضي صفر حتى تبقى الاتفاقيات القائمة صالحة بلا تعبئة (الترقية غير كاسرة).
  equipmentOwnerPrice Float         @default(0)
  validUntil          DateTime? // تاريخ انتهاء الاتفاقية (للتنبيه عند الاقتراب من الانتهاء)
  isArchived          Boolean       @default(false)
  customerId          Int?
  customer            Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceItems        InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isArchived])
  @@index([asphaltPlant])
  @@index([companyName])
  @@index([customerId])
  @@map("project_prices")
}

// ─────────────────────────────────────────────────────────────────────────
//  الشيكات (Cheques)
// ─────────────────────────────────────────────────────────────────────────

model Cheque {
  id                   Int       @id @default(autoincrement())
  chequeNumber         String    @unique
  chequeDate           DateTime
  beneficiaryName      String
  amount               Float
  currency             String    @default("KWD")
  description          String?
  bankName             String
  templateName         String?
  status               String    @default("DRAFT") // DRAFT | PRINTED | CANCELLED
  printedAt            DateTime?
  cancelledAt          DateTime?
  notes                String?
  paymentVoucherNumber String?   @unique // PV-000001 — set only on first Print Payment Voucher click

  // ── Reprint tracking (additive) ──────────────────────────────────────────
  // عدّاد الطباعة: 0 قبل أول طباعة، 1 عند أول طباعة، +1 لكل إعادة طباعة.
  // لا يغيّر دورة حياة الشيك (DRAFT/PRINTED/CANCELLED) ولا سلوك الطباعة القائم.
  printCount Int              @default(0)
  printLogs  ChequePrintLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([chequeDate])
  @@index([beneficiaryName])
  @@map("cheques")
}

// ─────────────────────────────────────────────────────────────────────────
//  نُسخ نماذج معايرة الشيكات (Cheque Template Versions)
//  سجل تاريخي إضافي لكل حفظ/استعادة لنموذج المعايرة لكل بنك. النموذج الفعّال
//  يبقى مخزّناً كما هو في Setting تحت المفتاح cheque.template.<bank>؛ هذه
//  الجداول إضافية فقط ولا تغيّر سلوك القالب الفعّال أو محرك الطباعة.
// ─────────────────────────────────────────────────────────────────────────

model ChequeTemplateVersion {
  id            Int      @id @default(autoincrement())
  bankName      String
  version       Int // رقم النسخة التصاعدي لكل بنك (1، 2، 3 ...)
  template      String // لقطة JSON كاملة من النموذج وقت الحفظ
  note          String? // سبب/ملاحظة اختيارية (مثل: «استعادة النسخة 3»)
  createdById   Int? // معرّف المستخدم (بدون علاقة FK لتفادي تعديل نموذج User)
  createdByName String? // اسم المستخدم وقت الحفظ (لقطة نصية)
  createdAt     DateTime @default(now())

  @@unique([bankName, version])
  @@index([bankName])
  @@map("cheque_template_versions")
}

// ─────────────────────────────────────────────────────────────────────────
//  قوالب مصمّم الشيكات (Cheque Designer Templates)
//
//  المصدر الوحيد للحقيقة لقوالب «مدير قوالب الشيكات» (Designer). كانت هذه
//  القوالب تُخزَّن في `localStorage` تحت `chequeDesigner.templates.v1` — وهي
//  البيانات الوحيدة التي ينشئها المستخدم خارج قاعدة البيانات. النتيجة أنها لم
//  تكن تدخل النسخ الاحتياطية ولا الاستعادة ولا مزامنة Google Drive، وكانت
//  تُفقد عند أي تغيير في `productName` أو `userData` أو عند الانتقال بين
//  التطوير والإنتاج أو إلى جهاز جديد (اختلاف partition/origin في Chromium).
//
//  التصميم: أعمدة مُصنَّفة لكل ما يستعلمه النظام أو يفرض عليه قاعدة (الهوية،
//  الاسم، علم الافتراضي، أبعاد السطح، الطوابع الزمنية)، و`fields` مستند JSON
//  واحد مُتحقَّق منه بـ Zod عند كل كتابة. حقول المصمّم واصف تخطيط مفتوح ومتطوّر
//  (موضع/حجم/دوران/خط/محاذاة/لون/ترتيب/ربط/ظهور)، وتطبيعه في جدول أبناء يفرض
//  ترحيلاً جديداً مع كل خاصية تُضاف، مقابل صفر مكسب استعلامي — فلا أحد يستعلم
//  «كل القوالب التي فيها حقل عند س>50».
//
//  `updatedAt` يُدار صراحةً في الخدمة (بلا `@updatedAt`) حتى يبقى ترتيب القائمة
//  مطابقاً تماماً للسلوك السابق: الإنشاء والحفظ وإعادة التسمية تُحدّثه، أما
//  تعيين القالب الافتراضي فلا — كما كان في `chequeDesignerStore` القديم.
// ─────────────────────────────────────────────────────────────────────────

model ChequeDesignerTemplate {
  id              String   @id // 'tpl-<uuid>' — تُحفظ كما هي عند الترحيل من localStorage
  name            String
  isDefault       Boolean  @default(false) // قالب افتراضي واحد على الأكثر (تفرضه الخدمة داخل معاملة)
  surfaceWidthCm  Float
  surfaceHeightCm Float
  fields          String // مصفوفة DesignerField كمستند JSON مُتحقَّق منه
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([isDefault])
  @@index([updatedAt])
  @@map("cheque_designer_templates")
}

// ─────────────────────────────────────────────────────────────────────────
//  سجل طباعة الشيكات (Cheque Print Logs)
//  يسجّل كل محاولة طباعة/إعادة طباعة. sequence=1 للطباعة الأولى (reason=null)،
//  و2 فأكثر لإعادات الطباعة (reason إلزامي). سجل تدقيقي إضافي لا يعطّل الطباعة.
// ─────────────────────────────────────────────────────────────────────────

model ChequePrintLog {
  id            Int      @id @default(autoincrement())
  chequeId      Int
  cheque        Cheque   @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  sequence      Int // 1 = طباعة أولى، 2+ = إعادة طباعة
  reason        String? // null للطباعة الأولى؛ إلزامي لإعادة الطباعة
  note          String? // ملاحظة حرة اختيارية (تُستخدم مع سبب «أخرى»)
  printedById   Int? // معرّف المستخدم (بدون علاقة FK)
  printedByName String? // اسم المستخدم وقت الطباعة (لقطة نصية)
  printedAt     DateTime @default(now())

  @@index([chequeId])
  @@map("cheque_print_logs")
}

// ─────────────────────────────────────────────────────────────────────────
//  تحليل الشغل والعمولة (Job & Commission Analysis)
//
//  أداة تحليل تشغيلية داخلية بحتة: تحسب الفرق بين سعر العميل (من اتفاقيات
//  الأسعار) وسعر صاحب المعدة الذي يُدخله المستخدم يدويًا — أي عمولة الشركة —
//  قبل إصدار أي فاتورة. ليست جزءًا من الدورة المحاسبية إطلاقًا.
//
//  ═══ لماذا لا توجد أي علاقة (relation) بأي نموذج قائم ═══
//
//  الجدولان أدناه لا يرتبطان بـ Customer ولا ProjectPrice ولا Contract ولا أي
//  نموذج آخر. كل المعرّفات الخارجية (`customerId`, `contractId`, `priceId`)
//  أعداد صحيحة مرجعية فقط — لا `@relation`، لا مفتاح أجنبي في قاعدة البيانات.
//  هذا قرار متعمَّد لثلاثة أسباب، لا اختصار:
//
//   (١) إضافة علاقة تفرض إضافة back-relation داخل `model ProjectPrice` و
//       `model Customer` و`model Contract` — أي تعديل نصّي على اتفاقيات الأسعار
//       وهي مطلوب بقاؤها دون أي مساس.
//   (٢) مفتاح أجنبي بـ Restrict كان سيمنع أرشفة/حذف اتفاقية سعر لمجرّد وجود
//       تحليل داخلي يشير إليها — أي أن أداة تحليل تعطّل وحدة تشغيلية. مرفوض.
//   (٣) التحليل **يجمّد** السعر لحظة إجرائه. لقطة نصية/رقمية مستقلة هي التمثيل
//       الصحيح دلاليًا: تعديل الاتفاقية لاحقًا يجب ألّا يغيّر تحليلًا قديمًا.
//
//  نفس نمط `ChequeTemplateVersion.createdById` و`ChequePrintLog.printedById`
//  المستقر في هذا المخطط أصلًا (معرّف بلا FK + لقطة اسم نصية).
//
//  ═══ عقد الكتابة ═══
//  لا تُكتب أي بيانات من هذه الوحدة خارج هذين الجدولين. لا قيود يومية، لا
//  فواتير، لا مصروفات، لا حركات، لا أرصدة عملاء.
// ─────────────────────────────────────────────────────────────────────────

model WorkAnalysis {
  id           Int      @id @default(autoincrement())
  analysisDate DateTime // تاريخ التحليل (DATE-ONLY، منتصف ليل UTC)
  status       String   @default("DRAFT") // DRAFT (مسودة) | COMPLETED (مكتمل) | ARCHIVED (مؤرشف)

  // ── مراجع خارجية: أرقام فقط، بلا FK (انظر التعليق أعلاه) ──
  customerId   Int? // معرّف العميل المرجعي — لا علاقة
  customerName String // لقطة اسم العميل وقت التحليل
  contractId   Int? // معرّف العقد المرجعي (اختياري) — لا علاقة
  contractName String? // لقطة وصف العقد وقت التحليل
  asphaltPlant String? // مصنع الأسفلت (مُرشِّح اختياري، لقطة نصية)

  ownerName String // صاحب المعدة — نص حر (اقتراحات فقط، بلا كيان)
  notes     String?

  createdById   Int? // معرّف المستخدم — لا علاقة (نفس نمط ChequeTemplateVersion)
  createdByName String? // لقطة اسم المستخدم وقت الإنشاء

  lines WorkAnalysisLine[] // العلاقة الوحيدة المسموحة: داخلية بين الجدولين الجديدين

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([analysisDate])
  @@index([customerId])
  @@index([ownerName])
  @@map("work_analyses")
}

model WorkAnalysisLine {
  id         Int          @id @default(autoincrement())
  analysisId Int
  analysis   WorkAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  // ── اللقطة المجمَّدة: تُكتب مرة واحدة ولا تُشتق أبدًا من ProjectPrice بعدها ──
  priceId            Int? // معرّف اتفاقية السعر المرجعي — لا علاقة، للتتبّع فقط
  priceAgreementName String // لقطة تعريف الاتفاقية (المصنع — الشركة)
  itemLabel          String // لقطة البند (مكان العقد)
  unit               String // لقطة وحدة العقد
  customerPrice      Float // لقطة سعر العميل وقت التحليل (لا يُقرأ حيًّا أبدًا)

  // ── مُدخَل المستخدم ──
  quantity   Float @default(0)
  ownerPrice Float @default(0) // سعر صاحب المعدة — إدخال يدوي حصرًا

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisId])
  @@map("work_analysis_lines")
}

// ─────────────────────────────────────────────────────────────────────────
//  محرك الخطابات — هوية المستند ودورة حياته (Letter Engine — P1)
//
//  ثلاثة جداول تحمل ضمانتين لا ثالث لهما في هذه الحزمة:
//
//   (١) الرقم المرجعي دائم. تسلسلي، لا يُعاد استخدامه، ولا يُعاد تدويره، والملغى
//       يبقى محجوزًا إلى الأبد. الضمانة **في المخطط نفسه** لا في منطق التطبيق:
//       قيدا التفرّد أدناه (`reference` و`templateKey+year+sequence`) هما ما يمنع
//       ازدواج رقم مرجعي، لا شرط `if` في خدمة.
//
//   (٢) المستند المسجَّل غير قابل للتعديل. `registrationSnapshotJson` تُكتب مرة
//       واحدة عند التسجيل ولا يمسّها أي مسار تحديث بعدها.
//
//  ═══ لماذا سجل المراجع منفصل عن جدول الخطابات ═══
//  `letter_references` سجل **إلحاقي** مستقل: يجب أن يبقى بعد الخطاب نفسه. لو فُقد
//  صفّ خطاب في استعادة جزئية، يظل الرقم محسوبًا ومعروف المصير — وهذا هو الفرق بين
//  فجوة مُفسَّرة (طبيعية في أي سجل رسمي) وفجوة مجهولة (ملاحظة تدقيق).
//
//  ولهذا `letterId` عدد صحيح **بلا مفتاح أجنبي** — نفس النمط المستقر في
//  `ChequePrintLog.printedById` و`WorkAnalysis.customerId`: مفتاح أجنبي بـ Cascade
//  كان سيحذف قيد السجل مع الخطاب، وهو بالضبط ما يجب ألّا يحدث.
// ─────────────────────────────────────────────────────────────────────────

/// عدّاد التسلسل لكل (قالب، سنة). يُصفَّر مع بداية كل سنة ميلادية.
///
/// العدّاد **ليس** مصدر الحقيقة الوحيد: `reconcileSequences()` تُشغَّل عند بدء
/// الخدمة وبعد كل استعادة نسخة احتياطية، فترفعه إلى أعلى تسلسل مسجَّل فعلًا. بلا
/// ذلك، استعادة نسخة أقدم من آخر خطاب صادر كانت ستُعيد إصدار أرقام موجودة على ورق
/// سُلّم للغير — وهي أخطر حالة فشل في المحرك كله.
model LetterSequence {
  id          Int      @id @default(autoincrement())
  templateKey String // مفتاح القالب (officialLetter) — مطابق لسجل القوالب في الواجهة
  year        Int // السنة الميلادية
  lastValue   Int      @default(0) // آخر تسلسل مُخصَّص
  updatedAt   DateTime @updatedAt

  @@unique([templateKey, year])
  @@map("letter_sequences")
}

/// السجل الرسمي للأرقام المرجعية — إلحاقي، ولا يُحذف منه صف أبدًا.
///
/// `status`: ALLOCATED (مُخصَّص) | CANCELLED (ملغى — والرقم يبقى محجوزًا).
model LetterReference {
  id          Int    @id @default(autoincrement())
  reference   String @unique // OL-2026-000001 — التفرّد مفروض في قاعدة البيانات
  templateKey String
  year        Int
  sequence    Int

  letterId Int? // معرّف الخطاب المرجعي — بلا مفتاح أجنبي عمدًا (انظر أعلاه)

  status       String  @default("ALLOCATED")
  cancelReason String?

  allocatedById   Int?
  allocatedByName String?
  allocatedAt     DateTime  @default(now())
  cancelledAt     DateTime?

  @@unique([templateKey, year, sequence])
  @@index([letterId])
  @@index([templateKey, year])
  @@map("letter_references")
}

/// خطاب واحد.
///
/// `reference` قابل للإفراغ **عمدًا**: المسودة بلا رقم مرجعي. الرقم يُحرق في لحظة
/// واحدة فقط — «تسجيل وإصدار رقم» — لا عند الإنشاء ولا عند أول حفظ. حقل إلزامي كان
/// سيفرض وجود رقم منذ الإنشاء ويحوّل كل مسودة مهجورة إلى فجوة دائمة في سجل رسمي.
///
/// محاور الإصدار الثلاثة و`printProfileId` تُقرأ من الصف ولا تُشتق أبدًا من
/// «الأحدث»: مستند صدر بإصدار ١ يُصيَّر بإصدار ١ ما بقي.
model Letter {
  id          Int    @id @default(autoincrement())
  templateKey String

  // ── محاور الإصدار — تُجمَّد عند التسجيل ولا يُعاد حسابها ──
  templateVersion Int
  layoutVersion   Int
  barcodeVersion  Int
  printProfileId  String

  /// DRAFT | REGISTERED | PRINTED | SUPERSEDED | CANCELLED
  ///
  /// **الأرشفة ليست حالة** — انظر `isArchived` أدناه. «هل ما زالت هذه مراسلة نشطة؟»
  /// سؤال مستقل عن «ماذا جرى لهذا المستند؟»، ولو كانت الأرشفة حالة لتعذّرت أرشفة
  /// خطاب ملغى، ولفُرض اختيار كاذب بين «مطبوع» و«مؤرشف» وكلاهما صحيح معًا.
  status    String  @default("DRAFT")
  reference String? @unique // null للمسودة

  /// علم الأرشفة — متعامد مع `status` لا سادس لحالاته.
  /// يُرفع ويُخفض ما دام المستند غير ملغى.
  isArchived Boolean @default(false)

  // ── محتوى المستند ──
  issueDate             DateTime
  recipientName         String?
  recipientTitle        String?
  recipientOrganisation String?
  subject               String   @default("")
  contentJson           String   @default("") // نموذج الكتل (Block Model) بصيغة JSON — لا HTML أبدًا
  contentModelVersion   Int

  /// التوقيع والختم — معرّف أصل من سجل العلامة التجارية القائم (`print.signatures` /
  /// `print.stamps`)، لا صورة ولا نسخة منها. تخزين المعرّف وحده يعني أن تحديث صورة
  /// التوقيع في الإعدادات ينعكس على كل مسودة تستخدمه، بينما اللقطة المجمَّدة عند
  /// التسجيل تحفظ ما طُبع فعلًا. كلاهما اختياري: «بلا توقيع» خيار مشروع.
  signatureAssetId String?
  stampAssetId     String?

  /// لقطة التسجيل — تُكتب مرة واحدة عند التسجيل، ولا يمسّها أي تحديث لاحق.
  registrationSnapshotJson String?

  // ── من فعل ماذا ومتى (لقطات نصية بلا مفاتيح أجنبية) ──
  createdById      Int?
  createdByName    String?
  registeredById   Int?
  registeredByName String?
  registeredAt     DateTime?
  archivedById     Int?
  archivedByName   String?
  archivedAt       DateTime?
  cancelledById    Int?
  cancelledByName  String?
  cancelledAt      DateTime?
  cancelReason     String?

  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  /// الخط الزمني للمستند — حدث لكل انتقال حالة ولكل أرشفة/إلغاء أرشفة.
  timeline  LetterTimelineEvent[]
  /// النسخ المحفوظة والتعليقات — Professional Document Automation v1.
  versions  LetterVersion[]
  comments  LetterComment[]

  @@index([status])
  @@index([templateKey, status])
  @@index([issueDate])
  @@index([isArchived])
  @@map("letters")
}

/// سجل زمني لكل ما جرى للمستند — حدث واحد لكل انتقال حالة، ولكل أرشفة/إلغاء أرشفة.
///
/// ═══ لماذا هذا الجدول موجود بينما الأعمدة تحمل نفس البيانات ═══
/// أعمدة `registeredAt` و`archivedAt` و`cancelledAt` تحمل **الحالة الراهنة**: من فعلها
/// آخر مرة ومتى. أمّا هذا الجدول فيحمل **التاريخ**: أُرشِف ثم أُلغيت أرشفته ثم أُرشِف
/// مجددًا — ثلاثة أحداث، بينما العمودان يحملان الأخير فقط.
/// وبلا هذا الجدول، إلغاء الأرشفة يمحو أثر الأرشفة السابقة نهائيًا.
///
/// ═══ لماذا مفتاح أجنبي هنا بينما سجل المراجع بلا مفتاح ═══
/// عكس `letter_references` تمامًا، وهذا مقصود: سجل المراجع **يجب أن يبقى بعد** الخطاب
/// لأن الرقم المرجعي يظل محسوبًا مهما جرى للمستند. أمّا الخط الزمني فهو تاريخ المستند
/// نفسه، والمستند الوحيد القابل للحذف هو المسودة — ومسودة لم يصدر لها رقم قط لا تترك
/// تاريخًا يستحق الحفظ. فالحذف المتتالي هنا صحيح، ويمنع تراكم صفوف يتيمة.
/// نسخة محفوظة من مستند الخطاب — Professional Document Automation v1.
///
/// ══════════════════════════════════════════════════════════════════════════
///  جدول مستقل، لا عمود في `letters`. والسبب أن النسخة تنمو بلا حدّ.
/// ══════════════════════════════════════════════════════════════════════════
/// كل نسخة صورة كاملة من `contentJson`، فتخزينها داخل `contentJson` نفسه يعني أن
/// المستند يحوي نسخًا من نفسه — ويتجاوز سقف الحقل (٢ ميغابايت) بعد نسخ قليلة.
/// الجدول المستقل يعطي فهرسًا، وحذفًا انتقائيًا، وحدًّا أقصى قابلًا للتطبيق.
///
/// اللقطة نصية بالكامل: لا مفاتيح أجنبية إلى المستخدم ولا إلى القالب. النسخة سجلّ
/// لِما كان، ويجب أن تبقى مقروءة بعد حذف المستخدم الذي أنشأها.
model LetterVersion {
  id       Int    @id @default(autoincrement())
  letterId Int
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  /// رقم تسلسلي داخل الخطاب الواحد — يبدأ من ١ ولا يُعاد استخدامه.
  /// فريد مع `letterId` حتى لا تتولّد نسختان بالرقم ذاته من طلبين متزامنين.
  sequence Int

  /// AUTO | NAMED | PRE_RESTORE | PRE_REGISTER
  ///
  /// `AUTO` لقطة دورية، و`NAMED` نسخة سمّاها المستخدم، و`PRE_RESTORE` تُلتقط قبل كل
  /// استعادة (حتى تكون الاستعادة نفسها قابلة للتراجع)، و`PRE_REGISTER` قبل التسجيل.
  kind String @default("AUTO")

  /// اسم النسخة إن سمّاها المستخدم.
  name String?
  /// ملاحظة حرة يكتبها المستخدم.
  note String?

  /// صورة المستند وقت الحفظ — نموذج الكتل بصيغة JSON، كما في `letters.contentJson`.
  contentJson           String
  contentModelVersion   Int
  /// حقول الأقسام وقت الحفظ، حتى تعيد الاستعادة الخطاب كاملًا لا محتواه فقط.
  subject               String   @default("")
  issueDate             DateTime
  recipientName         String?
  recipientTitle        String?
  recipientOrganisation String?

  /// إحصاءات محسوبة وقت الحفظ — تُعرض في القائمة بلا تحليل كل نسخة.
  wordCount Int @default(0)
  pageCount Int @default(0)

  createdById   Int?
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([letterId, sequence])
  @@index([letterId, createdAt])
  @@map("letter_versions")
}

/// تعليق على مستند الخطاب — Professional Document Automation v1.
///
/// الردود تعليقات أيضًا: `parentId` يشير إلى التعليق الأصل، فالخيط شجرة بمستوى واحد
/// ولا يحتاج جدولًا ثانيًا. المرساة (`anchorKind` + `anchorId`) تربط التعليق بفقرة أو
/// عنصر تصميم أو قسم، وكلها نصية — التعليق يبقى مقروءًا بعد حذف ما كان يشير إليه،
/// وتعليق يختفي مع الفقرة يفقد أهم ما فيه: أنه قيل.
model LetterComment {
  id       Int    @id @default(autoincrement())
  letterId Int
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  /// التعليق الأصل إن كان هذا ردًّا. `null` لتعليق في أعلى الخيط.
  parentId Int?
  parent   LetterComment?  @relation("LetterCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  LetterComment[] @relation("LetterCommentReplies")

  /// block | object | section | document
  anchorKind String  @default("document")
  /// معرّف الكتلة أو عنصر التصميم أو اسم القسم. `null` لتعليق على المستند كله.
  anchorId   String?

  body String

  /// أسماء المستخدمين المذكورين، مفصولة بفاصلة — لقطة نصية لا مفاتيح أجنبية.
  mentions String @default("")

  resolved       Boolean   @default(false)
  resolvedById   Int?
  resolvedByName String?
  resolvedAt     DateTime?

  createdById   Int?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([letterId])
  @@index([letterId, resolved])
  @@index([parentId])
  @@map("letter_comments")
}

model LetterTimelineEvent {
  id       Int    @id @default(autoincrement())
  letterId Int
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  /// CREATED | REGISTERED | PRINTED | SUPERSEDED | CANCELLED | ARCHIVED | UNARCHIVED
  eventType String

  /// الحالة قبل الحدث وبعده. كلتاهما `null` لحدثَي الأرشفة — فهما لا يغيّران الحالة.
  fromStatus String?
  toStatus   String?

  /// الرقم المرجعي وقت الحدث (يُملأ عند التسجيل والإلغاء) — لقطة نصية.
  reference String?
  /// سبب الحدث حين يكون إلزاميًا (الإلغاء).
  reason    String?

  actorId    Int?
  actorName  String?
  occurredAt DateTime @default(now())

  @@index([letterId])
  @@index([letterId, occurredAt])
  @@map("letter_timeline_events")
}

// ════════════════════════════════════════════════════════════════════════════
// مستحقات الموظف الشهرية (Employee Monthly Compensation v1)
//
// وحدة **مستقلة تمامًا** — مرحلة تجريبية. تقرأ من `Employee` قراءةً فقط (اسم، رقم،
// مسمّى، راتب أساسي)، ولا تكتب خارج الجداول الأربعة أدناه إطلاقًا: لا رواتب، ولا قيود
// يومية، ولا مصروفات، ولا بدلات/خصومات نظام الرواتب، ولا مستحقات نهاية الخدمة، ولا
// كشوف بنكية، ولا مراكز تكلفة. الأرقام هنا **لا تُرحَّل** إلى أي وحدة مالية.
//
// ═══ العلاقة بـ `Employee` ═══
// `employeeId` مفتاح أجنبي حقيقي (Cascade عند حذف الموظف). حقل العلاقة العكسي
// `Employee.compensationCalcs` **تفرضه Prisma** لكل علاقة، وهو حقل افتراضي لا يضيف
// أي عمود إلى جدول `employees` ولا يغيّر أي سلوك فيه — نفس ما تفعله وحدات
// `EmployeeEntitlementLedger` و`EmployeeFinalSettlement` القائمة.
//
// ═══ لقطة تاريخية (Snapshot) ═══
// عند **إنشاء** حسبة الشهر تُكتب لقطة بيانات الموظف والراتب الأساسي مرة واحدة. تغيّر
// الاسم أو المسمّى أو الراتب في ملف الموظف لاحقًا **لا يغيّر** كشوف الأشهر السابقة —
// الكشف يُبنى من اللقطة، لا من الملف الحيّ.
//
// ═══ نسخة واحدة لكل موظف/سنة/شهر ═══
// `@@unique([employeeId, year, month])` — لا إصدارات متعددة لنفس الشهر. التعديل
// يُحدِّث نفس السجل. الاعتماد حالة تنظيمية فقط: لا يقفل السجل، ولا يمنع التعديل أو الحذف.
model EmployeeCompensationCalculation {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year  Int
  month Int // 1..12

  /// DRAFT | APPROVED — الاعتماد تنظيمي بحت، لا يقفل السجل.
  status String @default("DRAFT")

  // ── لقطة الموظف: تُكتب عند الإنشاء ولا تُعاد قراءتها من ملف الموظف بعدها ──
  employeeNumberSnapshot String
  employeeNameSnapshot   String
  jobTitleSnapshot       String?
  departmentSnapshot     String?
  nationalitySnapshot    String?
  civilIdSnapshot        String?
  basicSalarySnapshot    Float

  /// إصدار قواعد الاحتساب القانونية المستخدمة وقت الإنشاء (`legal/kuwaitLabourLaw.ts`).
  legalRulesVersion String

  /// أجر الساعة المشتقّ من لقطة الراتب — محفوظ لأن الكشف التاريخي يجب أن يُعاد شرحه
  /// بنفس أرقامه حتى لو تغيّر القاسم القانوني في إصدار لاحق من المحرك.
  hourlyRateSnapshot Float

  // ── الإجماليات المشتقّة (تُعاد كتابتها في كل حفظ من محرك واحد) ──
  totalOvertimeAmount Float @default(0)
  totalOtherEarnings  Float @default(0)
  grossEntitlements   Float @default(0)
  totalDeductions     Float @default(0)
  netAmount           Float @default(0)

  notes String?

  overtimeLines OvertimeLine[]
  earningLines  CompensationEarningLine[]
  deductionLines CompensationDeductionLine[]
  /// حركات سداد المديونيات الناشئة عن هذه الحسبة — تُحذف بحذفها (Cascade).
  debtPayments  EmployeeCompensationDebtPayment[]

  createdById   Int?
  createdByName String?
  approvedAt    DateTime?
  approvedById  Int?
  approvedByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([employeeId, year])
  @@map("employee_compensation_calculations")
}

/// سطر عمل إضافي واحد من نوع قانوني واحد.
/// `method` = MANUAL_HOURS | REVERSE_FROM_AMOUNT — بيانات تدقيق داخلية فقط، لا تظهر
/// في الكشف الرسمي المختصر إطلاقًا (المتطلب ١١).
model OvertimeLine {
  id            Int                             @id @default(autoincrement())
  calculationId Int
  calculation   EmployeeCompensationCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  /// REGULAR | WEEKLY_REST | OFFICIAL_HOLIDAY
  overtimeType String
  hours        Float
  hourlyRate   Float
  multiplier   Float
  amount       Float

  /// MANUAL_HOURS | REVERSE_FROM_AMOUNT
  calculationMethod  String  @default("MANUAL_HOURS")
  reverseTargetAmount Float?
  /// الساعات الخام قبل التقريب لأعلى (الحسبة العكسية فقط).
  rawHoursBeforeCeiling Float?
  /// المادة/المرجع القانوني المطبَّق — نص ثابت من محرك القواعد.
  legalReference String
  notes          String?
  sortOrder      Int     @default(0)

  @@index([calculationId])
  @@map("employee_compensation_overtime_lines")
}

/// استحقاق آخر (مكافأة/منحة/حافز/بدل/تعويض مصروف/مخصص). **لا** علاقة له بجداول
/// `EmployeeAllowance` أو `Bonus` في نظام الرواتب — بند خاص بهذه الوحدة وحدها.
model CompensationEarningLine {
  id            Int                             @id @default(autoincrement())
  calculationId Int
  calculation   EmployeeCompensationCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  /// BONUS | GRANT | INCENTIVE | ALLOWANCE | EXPENSE_REIMBURSEMENT | CUSTOM
  type      String
  label     String
  amount    Float
  entryDate DateTime?
  reason    String?
  notes     String?
  recurring Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([calculationId])
  @@map("employee_compensation_earning_lines")
}

/// استقطاع (غياب/سلفة/جزاء/خصم/مخصص). **لا** يُنشئ ولا يُعدّل أي `Deduction` أو
/// `PayrollAdvance` في نظام الرواتب.
model CompensationDeductionLine {
  id            Int                             @id @default(autoincrement())
  calculationId Int
  calculation   EmployeeCompensationCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  /// ABSENCE | ADVANCE | PENALTY | DISCOUNT | CUSTOM | DEBT_REPAYMENT
  type      String
  label     String
  amount    Float
  notes     String?
  sortOrder Int    @default(0)

  /// سداد مديونية: ربط **صريح** بالسجل، لا استدلال من نصّ `label`.
  /// `Restrict` عمدًا: لا تُحذف مديونية عليها استقطاع محفوظ بصمت (المتطلب ١١).
  debtId Int?
  debt   EmployeeCompensationDebt? @relation(fields: [debtId], references: [id], onDelete: Restrict)

  /// حركة الدفتر المقابلة لهذا السطر — علاقة عكسية فقط (تملكها حركة الدفتر).
  debtPayment EmployeeCompensationDebtPayment?

  @@index([calculationId])
  @@index([debtId])
  @@map("employee_compensation_deduction_lines")
}

// ════════════════════════════════════════════════════════════════════════════
// سجل المديونيات والسلف (Employee Compensation Debt & Advances Ledger v1)
//
// امتداد لوحدة مستحقات الموظف الشهرية، **بنفس عزلها حرفيًا**: لا رواتب، ولا محاسبة،
// ولا قيود يومية، ولا مصروفات. سلفةٌ هنا ليست سلفة الرواتب (`PayrollAdvance`)، ولا
// تنشئها ولا تقرؤها ولا تتأثر بها — سجل مستقل تمامًا لهذه الوحدة وحدها.
//
// ═══ لا رصيد مخزَّن — إطلاقًا ═══
// لا يوجد عمود `remainingBalance` ولا `paidAmount` ولا `status`. الرصيد **يُشتقّ**
// دائمًا: `originalAmount − SUM(payments.amount)`، والحالة تُشتقّ منه. عمودٌ مخزَّن كان
// سيصير مصدر حقيقة ثانيًا يتباعد عن الدفتر عند أول تعديل يفشل في تحديثه — وهو بالضبط
// صنف العيب الذي يجعل موظفًا يُخصم منه مرتين أو لا يُخصم أبدًا.
//
// ═══ هوية حركة السداد الشهرية ═══
// `@@unique([calculationId, debtId])` هو ما يجعل التعديل **idempotent**: تعديل استقطاع
// من ٢٥ إلى ١٥ يُحدِّث **نفس** الصف بدل أن يضيف صفًّا ثانيًا فوقه. ولأن SQLite تعدّ
// الـNULL قيمًا متمايزة، لا يقيّد هذا الفهرس السدادات اليدوية (`calculationId = NULL`)،
// فيجوز للموظف عدة سدادات يدوية على المديونية نفسها.
model EmployeeCompensationDebt {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// ADVANCE (سلفة) | DEBT (مديونية أخرى) | CUSTOM
  type String

  /// بيان السجل كما يكتبه المستخدم — «سلفة شراء سيارة»، «مديونية وقود».
  label          String
  originalAmount Float
  debtDate       DateTime
  notes          String?

  createdById   Int?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments       EmployeeCompensationDebtPayment[]
  deductionLines CompensationDeductionLine[]

  @@index([employeeId])
  @@index([employeeId, debtDate])
  @@map("employee_compensation_debts")
}

/// حركة سداد واحدة على مديونية — **دفتر الحقيقة الوحيد** الذي يُشتقّ منه الرصيد.
model EmployeeCompensationDebtPayment {
  id     Int                      @id @default(autoincrement())
  debtId Int
  /// `Restrict`: لا تُحذف مديونية عليها حركات بصمت — الحذف يُرفض برسالة صريحة.
  debt   EmployeeCompensationDebt @relation(fields: [debtId], references: [id], onDelete: Restrict)

  amount      Float
  paymentDate DateTime

  /// MONTHLY_COMPENSATION (من حسبة شهر) | MANUAL_PAYMENT (سداد خارج الحسبة)
  sourceType String

  /// حسبة الشهر المصدر. `Cascade`: حذف الحسبة يُلغي سدادها فيرتدّ الرصيد تلقائيًا —
  /// لا حركة يتيمة تبقى تخصم من موظف عن شهر لم يعد موجودًا.
  calculationId Int?
  calculation   EmployeeCompensationCalculation? @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  /// مؤشّر إلى سطر الاستقطاع المقابل — **للعرض والتتبّع**، لا للهوية.
  /// الهوية هي `(calculationId, debtId)`، لأن سطور الاستقطاع تُستبدل بالكامل عند كل
  /// حفظ (تُحذف وتُنشأ من جديد)، فمعرّفها يتغيّر بينما الحركة نفسها تبقى.
  deductionLineId Int?                       @unique
  deductionLine   CompensationDeductionLine? @relation(fields: [deductionLineId], references: [id], onDelete: SetNull)

  notes         String?
  createdById   Int?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([calculationId, debtId])
  @@index([debtId])
  @@index([calculationId])
  @@map("employee_compensation_debt_payments")
}

// ═══════════════════════════════════════════════════════════════════════════
//  كشف المستحقات الشهرية البنكي — Monthly Entitlements Bank Statement v1
//
//  جدولان **إضافيان بالكامل**: لا جدول قائم يُعدَّل، ولا عمود يُحذف أو يُعاد تسميته.
//  الكشف مستقل تمامًا عن مسير الرواتب وعن كشف الرواتب البنكي: اعتماده أو إلغاؤه لا
//  يمسّ Payroll ولا SalaryPayment ولا EmployeeCompensation ولا دفتر الأستاذ ولا
//  المصروفات — لا قيد، لا ترحيل، لا تحديث حالة في أي وحدة أخرى.
//
//  **لماذا لا توجد مفاتيح أجنبية إلى Employee ولا إلى الحسبة الشهرية؟**
//  لأن السطر المعتمد **مستند تاريخي مجمَّد**. حذف موظف أو حذف حسبة شهر لا يجوز أن
//  يمحو — أو يغيّر — كشفًا بنكيًا صدر فعلًا وذهب إلى البنك. المعرّفان محفوظان كأرقام
//  للتتبّع والربط، والقيم النقدية والبنكية محفوظة كلقطة مستقلة عن مصدرها.
// ═══════════════════════════════════════════════════════════════════════════

/// رأس كشف المستحقات الشهري المعتمد لشهر/سنة واحدة.
/// `@@unique([year, month])`: كشف معتمد واحد لكل شهر — الحارس البنيوي ضد ازدواج
/// تحويل غير مقصود لنفس الموظف في نفس الشهر.
model EntitlementsBankStatement {
  id    Int @id @default(autoincrement())
  year  Int
  month Int // 1..12

  /// معرّف ملف البنك المستخدم وقت الاعتماد (`nbk_entitlements_xls`).
  profileId String
  currency  String @default("KWD")

  /// APPROVED فقط في v1 — الكشف لا يوجد إلا معتمدًا؛ إلغاء الاعتماد يحذف السجل
  /// بإجراء صريح مسجَّل، لا بتغيير صامت في قيمه.
  status String @default("APPROVED")

  /// إجماليات وقت الاعتماد — مجمّدة، لا تُحتسب من جديد عند القراءة.
  employeeCount Int   @default(0)
  totalAmount   Float @default(0)

  approvedAt     DateTime @default(now())
  approvedById   Int?
  approvedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines EntitlementsBankStatementLine[]

  @@unique([year, month])
  @@index([year, month])
  @@map("entitlements_bank_statements")
}

/// سطر موظف واحد داخل كشف مستحقات معتمد — لقطة كاملة لما ذهب إلى البنك.
model EntitlementsBankStatementLine {
  id          Int                       @id @default(autoincrement())
  statementId Int
  statement   EntitlementsBankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  /// مرجع للتتبّع فقط — بلا مفتاح أجنبي (انظر شرح الجدولين أعلاه).
  employeeId Int
  /// معرّف حسبة المستحقات الشهرية المصدر — للتتبّع فقط، بلا مفتاح أجنبي: تعديل تلك
  /// الحسبة أو حذفها لاحقًا لا يغيّر ولا يحذف هذا السطر.
  calculationId Int?

  // ── لقطة الموظف والبيانات البنكية وقت الاعتماد ──
  employeeCodeSnapshot   String
  employeeNameSnapshot   String
  employeeNameEnSnapshot String?
  civilIdSnapshot        String?
  bankAccountSnapshot    String?

  // ── لقطة الأرقام: المعادلة الوحيدة هي transferAmount = net − basic ──
  netAmountSnapshot    Float
  basicSalarySnapshot  Float
  transferAmount       Float

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// موظف واحد لا يظهر مرتين في نفس الكشف.
  @@unique([statementId, employeeId])
  @@index([statementId])
  @@index([employeeId])
  @@map("entitlements_bank_statement_lines")
}
