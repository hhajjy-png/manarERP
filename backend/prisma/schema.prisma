// ════════════════════════════════════════════════════════════════════════
//  نظام إدارة أعمال شركة المنار — مخطط قاعدة البيانات (Prisma + SQLite)
//  ملاحظة: SQLite لا يدعم الـ enum في Prisma، لذلك تُستخدم حقول String
//          مع توثيق القيم المسموحة، ويُفرض التحقق منها في طبقة Zod.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  المصادقة والصلاحيات (Auth & RBAC)
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String // bcrypt
  fullName     String
  email        String?   @unique
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  // ربط اختياري بسجل الموظف
  employeeId Int?      @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  auditLogs         AuditLog[]
  backups           Backup[]
  approvalHistories ApprovalHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique // SYSTEM_ADMIN, GENERAL_MANAGER, ACCOUNTANT...
  displayName String // الاسم العربي المعروض
  description String?
  isSystem    Boolean @default(false) // أدوار النظام لا تُحذف

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique // مثال: invoices.create, equipment.delete
  module      String // invoices, equipment, contracts...
  action      String // create, read, update, delete, approve
  description String?

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
//  العملاء (Customers)
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id          Int     @id @default(autoincrement())
  code        String  @unique // رقم العميل
  name        String
  type        String  @default("PRIVATE") // GOVERNMENT | PRIVATE
  category    String? // تصنيف العميل
  phone       String?
  email       String?
  address     String?
  contactName String? // اسم المسؤول
  notes       String?
  isArchived  Boolean @default(false)

  contracts     Contract[]
  invoices      Invoice[]
  projectPrices ProjectPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isArchived])
  @@index([isArchived, type])
  @@index([name])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────
//  الموظفون والموارد البشرية (Employees / HR)
// ─────────────────────────────────────────────────────────────────────────

model Employee {
  id                   Int       @id @default(autoincrement())
  code                 String    @unique // الرقم الوظيفي
  fullName             String // اسم الموظف (بالعربي)
  fullNameEn           String? // اسم الموظف (بالإنجليزي)
  civilId              String? // الرقم المدني
  jobTitle             String? // المهنة
  nationality          String? // الجنسية
  passportNumber       String? // رقم جواز السفر
  passportExpiry       DateTime? // تاريخ انتهاء جواز السفر
  residencyExpiry      DateTime? // تاريخ انتهاء الإقامة
  licenseExpiry        DateTime? // تاريخ انتهاء رخصة القيادة
  vehiclePlate         String? // رقم لوحة المركبة
  vehicleLicenseExpiry DateTime? // تاريخ انتهاء رخصة المركبة
  birthDate            DateTime? // تاريخ الميلاد
  company              String? // الشركة
  department           String? // القسم
  salary               Float     @default(0) // الراتب الشهري
  hireDate             DateTime?
  phone                String?
  email                String?
  address              String? // العنوان
  photoPath            String? // مسار صورة الموظف
  bankAccount          String? // رقم الحساب البنكي (للتطابق في استيراد الرواتب)
  status               String    @default("ACTIVE") // ACTIVE | ON_LEAVE | TERMINATED
  notes                String?

  user                User?
  attendance          Attendance[]
  payrolls            Payroll[]
  recurringAllowances EmployeeAllowance[]
  recurringDeductions EmployeeRecurringDeduction[]
  advances            PayrollAdvance[]
  leaves              Leave[]
  deductions          Deduction[]
  bonuses             Bonus[]
  performanceRevs     PerformanceReview[]
  approvedExpenses    Expense[]                    @relation("ExpenseApprover")
  managedContracts    Contract[]                   @relation("ContractManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([status])
  @@index([civilId])
  @@index([bankAccount])
  @@index([residencyExpiry])
  @@index([passportExpiry])
  @@index([licenseExpiry])
  @@map("employees")
}

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT") // PRESENT | ABSENT | LATE | LEAVE
  workHours  Float?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

model Leave {
  id         Int      @id @default(autoincrement())
  employeeId Int
  type       String // ANNUAL | SICK | UNPAID | EMERGENCY
  startDate  DateTime
  endDate    DateTime
  days       Int
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reason     String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

model Deduction {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Float
  reason     String?
  date       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("deductions")
}

model Bonus {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Float
  reason     String?
  date       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("bonuses")
}

model Payroll {
  id                      Int       @id @default(autoincrement())
  employeeId              Int
  month                   Int // 1-12
  year                    Int
  baseSalary              Float
  snapshotBaseSalary      Float     @default(0)
  regularWorkDays         Int       @default(0)
  presentDays             Int       @default(0)
  absentDays              Int       @default(0)
  leaveDays               Int       @default(0)
  lateDays                Int       @default(0)
  regularHours            Float     @default(0)
  actualHours             Float     @default(0)
  overtimeHours           Float     @default(0)
  overtimeRate            Float     @default(0)
  overtimeAmount          Float     @default(0)
  totalBonus              Float     @default(0)
  totalAllowances         Float     @default(0)
  /// Deprecated: kept for backward compatibility. Use totalDeductions for new payroll calculations.
  totalDeduction          Float     @default(0)
  totalDeductions         Float     @default(0)
  totalAdvances           Float     @default(0)
  grossSalary             Float     @default(0)
  netSalary               Float
  status                  String    @default("DRAFT") // DRAFT | APPROVED | PAID | CANCELLED
  approvedAt              DateTime?
  approvedById            Int?
  paidAt                  DateTime?
  paidById                Int?
  paymentMethod           String?
  accountingPostedAt      DateTime?
  accountingTransactionId Int?
  notes                   String?

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    PayrollLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([year, month])
  @@index([employeeId])
  @@index([status])
  @@index([accountingTransactionId])
  @@map("payroll")
}

model PayrollLine {
  id         Int     @id @default(autoincrement())
  payrollId  Int
  employeeId Int
  type       String // BASE | ALLOWANCE | DEDUCTION | ADVANCE | OVERTIME | ATTENDANCE
  sourceType String? // EMPLOYEE | RECURRING_ALLOWANCE | RECURRING_DEDUCTION | ADVANCE | ATTENDANCE | MANUAL
  sourceId   Int?
  label      String
  amount     Float   @default(0)
  quantity   Float?
  rate       Float?
  notes      String?

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([payrollId])
  @@index([employeeId])
  @@index([type])
  @@index([sourceType, sourceId])
  @@map("payroll_lines")
}

model EmployeeAllowance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  name       String
  amount     Float
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([isActive])
  @@map("employee_allowances")
}

model EmployeeRecurringDeduction {
  id         Int       @id @default(autoincrement())
  employeeId Int
  name       String
  amount     Float
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([isActive])
  @@map("employee_recurring_deductions")
}

model PayrollAdvance {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  amount          Float
  remainingAmount Float
  date            DateTime @default(now())
  status          String   @default("OPEN") // OPEN | SETTLED | CANCELLED
  notes           String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@map("payroll_advances")
}

model PerformanceReview {
  id         Int      @id @default(autoincrement())
  employeeId Int
  period     String // مثال: 2026-Q1
  score      Float // 0-100
  reviewer   String?
  comments   String?
  date       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("performance_reviews")
}

// ─────────────────────────────────────────────────────────────────────────
//  المعدات والآليات (Equipment)
// ─────────────────────────────────────────────────────────────────────────

model Equipment {
  id                 Int       @id @default(autoincrement())
  code               String    @unique // رقم المعدة
  name               String? // اسم المعدة (اختياري)
  type               String // قلاب | شيول | حفار | مدحلة | رصاصة | معدة خفيفة
  ownerName          String? // اسم المالك
  driverName         String? // اسم السائق
  plateNumber        String? // رقم اللوحة
  registrationExpiry DateTime? // تاريخ انتهاء دفتر المركبة
  status             String    @default("WORKING") // WORKING (تعمل) | NOT_WORKING (لا تعمل)
  manufacturer       String?
  model              String?
  manufactureYear    Int?
  serialNumber       String?
  currentLocation    String?
  operatingHours     Float     @default(0)
  purchaseDate       DateTime?
  purchaseCost       Float?
  notes              String?

  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]
  breakdowns         Breakdown[]
  spareParts         SparePartUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([registrationExpiry])
  @@map("equipment")
}

model MaintenanceRecord {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  type        String // PREVENTIVE | CORRECTIVE
  description String
  cost        Float     @default(0)
  performedBy String?
  date        DateTime
  nextDueDate DateTime? // موعد الصيانة الدورية القادمة
  status      String    @default("COMPLETED") // SCHEDULED | IN_PROGRESS | COMPLETED

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([equipmentId])
  @@index([nextDueDate])
  @@map("maintenance_records")
}

model FuelLog {
  id          Int      @id @default(autoincrement())
  equipmentId Int
  liters      Float
  cost        Float
  odometer    Float?
  date        DateTime @default(now())
  notes       String?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([date])
  @@map("fuel_logs")
}

model Breakdown {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  description String
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  severity    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String    @default("OPEN") // OPEN | RESOLVED

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@map("breakdowns")
}

model SparePartUsage {
  id          Int      @id @default(autoincrement())
  equipmentId Int
  partName    String
  quantity    Int      @default(1)
  unitCost    Float    @default(0)
  totalCost   Float    @default(0)
  date        DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@map("spare_part_usage")
}

// ─────────────────────────────────────────────────────────────────────────
//  العقود (Contracts) — عقود نقل الأسفلت الشهرية مع مصانع الأسفلت
// ─────────────────────────────────────────────────────────────────────────

model Contract {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique // رقم العقد
  asphaltPlant          String // اسم مصنع الأسفلت
  location              String? // مكان العقد
  monthlyTransportValue Float     @default(0) // قيمة نقل الأسفلت الشهري
  startDate             DateTime?
  endDate               DateTime?
  status                String    @default("ACTIVE") // ACTIVE | EXPIRED | RENEWING | SUSPENDED
  notes                 String?
  unitName              String? // وحدة العقد (مثل: درب، طن، متر)
  price                 Float?  // سعر الوحدة
  companyName           String? // اسم الشركة المنفذة

  customerId Int? // الجهة المتعاقدة (اختياري)
  managerId  Int? // المسؤول عن العقد

  customer  Customer?          @relation(fields: [customerId], references: [id])
  manager   Employee?          @relation("ContractManager", fields: [managerId], references: [id])
  invoices       Invoice[]
  expenses       Expense[]
  documents      ContractDocument[]
  materialIssues MaterialIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("contracts")
}

model ContractDocument {
  id         Int      @id @default(autoincrement())
  contractId Int
  title      String
  filePath   String // مسار الملف/الصورة
  fileType   String? // image | pdf | doc
  uploadedAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_documents")
}

// ─────────────────────────────────────────────────────────────────────────
//  الموردون (Suppliers)
// ─────────────────────────────────────────────────────────────────────────

model Supplier {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  phone       String?
  email       String?
  address     String?
  contactName String?
  notes       String?
  isArchived  Boolean @default(false)

  invoices       Invoice[]
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────
//  الفواتير (Invoices) — تشمل فواتير العملاء وفواتير الموردين
// ─────────────────────────────────────────────────────────────────────────

model Invoice {
  id            Int       @id @default(autoincrement())
  number        String    @unique // رقم الفاتورة
  invoiceNumber String    @unique // الرقم اليدوي الكامل للفاتورة: MN-INV-2026-...
  direction     String    @default("SALES") // SALES (عميل) | PURCHASE (مورّد)
  invoiceType   String    @default("نقل اسفلت") // نقل اسفلت | يومية عمل مالينج | يومية نقل اسفلت
  customerId    Int?
  supplierId    Int?
  contractId    Int?
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  subtotal      Float     @default(0)
  taxRate       Float     @default(0) // نسبة الضريبة %
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  paidAmount    Float     @default(0)
  status        String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE | CANCELLED
  notes             String?
  verificationUuid  String?  @unique
  billingMonth  Int?      // شهر الحساب (1-12)
  billingYear   Int?      // سنة الحساب (مثال: 2026)
  deliveryDate  DateTime? // تاريخ تسليم الفاتورة (متابعة داخلية — لا يظهر في الطباعة)
  paymentMethod String?   // GL routing: CASH | BANK | ACCOUNTS_PAYABLE — فواتير المشتريات فقط

  customer Customer?     @relation(fields: [customerId], references: [id])
  supplier Supplier?     @relation(fields: [supplierId], references: [id])
  contract Contract?     @relation(fields: [contractId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([direction])
  @@index([status])
  @@index([customerId])
  @@index([supplierId])
  @@index([contractId])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          Int    @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Float  @default(1)
  unit        String @default("طن") // طن | درب | يومية
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  priceId     Int?   // FK to project_prices (nullable — immutable snapshot, set at creation)

  invoice Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  price   ProjectPrice? @relation(fields: [priceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([priceId])
  @@map("invoice_items")
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  amount    Float
  method    String   @default("CASH") // CASH | BANK | CHEQUE | TRANSFER
  date      DateTime @default(now())
  reference String?
  notes     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────
//  المصروفات (Expenses)
// ─────────────────────────────────────────────────────────────────────────

model Expense {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  category     String // FUEL | SALARIES | MAINTENANCE | RENT | PURCHASES | EQUIPMENT | SERVICES | EQUIPMENT_RENT | TRUCK_RENT | HASSAN | GHANEM | NATHEER | HAROON | OTHER
  description  String
  amount       Float
  date         DateTime  @default(now())
  billingMonth Int?      // شهر الحساب (1-12)
  billingYear  Int?      // سنة الحساب
  notes        String?   // ملاحظات حرة
  contractId    Int?
  supplierId    Int?
  supplierName  String?   // اسم مورد حر (عند عدم وجوده في قائمة الموردين)
  documentPath  String? // مستند مرفق
  paymentMethod String  @default("CASH") // CASH | BANK | ACCOUNTS_PAYABLE
  status        String  @default("PENDING") // PENDING | APPROVED | REJECTED | REVERSED | CANCELLED
  approvedById  Int?
  approvedAt    DateTime?

  contract   Contract? @relation(fields: [contractId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  approvedBy Employee? @relation("ExpenseApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([status, date])
  @@index([contractId])
  @@index([date])
  @@index([billingMonth, billingYear])
  @@index([supplierId])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────
//  القيود المحاسبية (Transactions / Journal Entries)
// ─────────────────────────────────────────────────────────────────────────

model Transaction {
  id            Int      @id @default(autoincrement())
  entryNumber   String   @unique // رقم القيد
  date          DateTime @default(now())
  description   String
  type          String // REVENUE | EXPENSE | TRANSFER | ADJUSTMENT
  debit         Float    @default(0) // مدين
  credit        Float    @default(0) // دائن
  account       String // اسم/رمز الحساب
  referenceType String? // INVOICE | EXPENSE | PAYROLL | MANUAL
  referenceId   Int? // معرّف المستند المرتبط

  createdAt DateTime @default(now())

  @@index([date])
  @@index([type])
  @@index([account])
  @@index([referenceType, referenceId])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────
//  سجل التدقيق (Audit Log)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | RESTORE...
  module    String // الوحدة المتأثرة
  entityId  String? // معرّف السجل المتأثر
  oldValue  String? // JSON للقيم قبل التغيير
  newValue  String? // JSON للقيم بعد التغيير
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
//  سجل الاعتماد (Approval History) — تاريخ حالات الموافقة عبر الوحدات
// ─────────────────────────────────────────────────────────────────────────

model ApprovalHistory {
  id           Int      @id @default(autoincrement())
  entityType   String   // 'expense' | 'payroll' | 'invoice' | future modules
  entityId     Int
  action       String   // 'approve' | 'reject' | 'submit' | 'cancel' | 'reopen' | 'pay'
  fromStatus   String
  toStatus     String
  userId       Int?     // null for system-initiated transitions
  comment      String?
  reason       String?
  metadataJson String?  // JSON blob for future extensibility

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("approval_history")
}

// ─────────────────────────────────────────────────────────────────────────
//  النسخ الاحتياطي (Backups)
// ─────────────────────────────────────────────────────────────────────────

model Backup {
  id          Int      @id @default(autoincrement())
  fileName    String
  filePath    String
  sizeBytes   Int      @default(0)
  type        String   @default("MANUAL") // MANUAL | AUTO | SCHEDULED
  status      String   @default("SUCCESS") // SUCCESS | FAILED
  createdById Int?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([type])
  @@index([createdAt])
  @@map("backups")
}

// ─────────────────────────────────────────────────────────────────────────
//  دليل الحسابات (Chart of Accounts)
// ─────────────────────────────────────────────────────────────────────────

model Account {
  id            Int     @id @default(autoincrement())
  code          String  @unique // رمز الحساب (مثل: 1100)
  name          String // اسم الحساب
  type          String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalBalance String  @default("DEBIT") // DEBIT | CREDIT
  isActive      Boolean @default(true)
  parentId      Int? // الحساب الرئيسي (للتسلسل الهرمي)
  notes         String?

  parent       Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]          @relation("AccountHierarchy")
  journalLines JournalEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("accounts")
}

// ─────────────────────────────────────────────────────────────────────────
//  قيود اليومية بالقيد المزدوج (Journal Entries — Double Entry)
// ─────────────────────────────────────────────────────────────────────────

model JournalEntry {
  id            Int      @id @default(autoincrement())
  entryNumber   String   @unique // رقم القيد (JRN-2026-00001)
  date          DateTime @default(now())
  description   String
  referenceType String? // INVOICE | EXPENSE | PAYROLL | MANUAL
  referenceId   Int?
  status        String   @default("POSTED") // DRAFT | POSTED | CANCELLED

  lines JournalEntryLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([referenceType, referenceId]) // حماية على مستوى قاعدة البيانات ضد الترحيل المزدوج (SQLite يعامل NULL كقيم متمايزة)
  @@index([date])
  @@index([status])
  @@index([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             Int     @id @default(autoincrement())
  journalEntryId Int
  accountId      Int
  description    String?
  debit          Float   @default(0)
  credit         Float   @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// ─────────────────────────────────────────────────────────────────────────
//  الإعدادات (Settings) — مخزن مفتاح/قيمة
// ─────────────────────────────────────────────────────────────────────────

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique // company.name, invoice.taxRate, backup.cron...
  value     String // مخزّنة كنص/JSON
  group     String   @default("general") // general | company | finance | backup
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

// ─────────────────────────────────────────────────────────────────────────
//  المستودع والمواد (Inventory)
// ─────────────────────────────────────────────────────────────────────────

model MaterialCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)

  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("material_categories")
}

model Material {
  id           Int    @id @default(autoincrement())
  code         String @unique
  name         String
  categoryId   Int
  unit         String // طن | كيلو | لتر | قطعة | متر | كيس | برميل | صندوق
  unitCost     Float  @default(0)
  currentStock Float  @default(0)
  minimumStock Float  @default(0) // عتبة التنبيه عند انخفاض المخزون
  isActive     Boolean @default(true)
  notes        String?

  category           MaterialCategory    @relation(fields: [categoryId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  issueItems         MaterialIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@map("materials")
}

model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  number       String    @unique // PO-2026-00001
  supplierId   Int
  date         DateTime  @default(now())
  expectedDate DateTime?
  status       String    @default("DRAFT") // DRAFT | SUBMITTED | RECEIVED | CANCELLED
  notes        String?
  totalAmount  Float     @default(0)

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([date])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int   @id @default(autoincrement())
  purchaseOrderId Int
  materialId      Int
  quantity        Float
  unitCost        Float @default(0)
  totalCost       Float @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([purchaseOrderId])
  @@index([materialId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                      Int       @id @default(autoincrement())
  number                  String    @unique // GR-2026-00001
  purchaseOrderId         Int?
  supplierId              Int
  date                    DateTime  @default(now())
  status                  String    @default("DRAFT") // DRAFT | POSTED
  notes                   String?
  totalCost               Float     @default(0)
  accountingPostedAt      DateTime?
  accountingTransactionId Int? // references Transaction.id — prevents double posting

  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  items         GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([date])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             Int   @id @default(autoincrement())
  goodsReceiptId Int
  materialId     Int
  quantity       Float
  unitCost       Float @default(0)
  totalCost      Float @default(0)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  material     Material     @relation(fields: [materialId], references: [id])

  @@index([goodsReceiptId])
  @@index([materialId])
  @@map("goods_receipt_items")
}

// ─────────────────────────────────────────────────────────────────────────
//  سندات الصرف (Material Issues) — صرف مواد للمشاريع/العقود
// ─────────────────────────────────────────────────────────────────────────

model MaterialIssue {
  id                      Int       @id @default(autoincrement())
  number                  String    @unique // MI-2026-00001
  contractId              Int?
  date                    DateTime  @default(now())
  status                  String    @default("DRAFT") // DRAFT | POSTED | CANCELLED
  notes                   String?
  totalCost               Float     @default(0)
  accountingPostedAt      DateTime?
  accountingTransactionId Int? // references Transaction.id — prevents double posting

  contract Contract?         @relation(fields: [contractId], references: [id])
  items    MaterialIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([status])
  @@index([date])
  @@map("material_issues")
}

model MaterialIssueItem {
  id               Int   @id @default(autoincrement())
  materialIssueId  Int
  materialId       Int
  quantity         Float
  unitCostSnapshot Float @default(0) // WAC snapshot at time of posting
  totalCost        Float @default(0)

  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([materialIssueId])
  @@index([materialId])
  @@map("material_issue_items")
}

// ─────────────────────────────────────────────────────────────────────────
//  الرواتب — عمليات صرف الرواتب (Salary Payments)
// ─────────────────────────────────────────────────────────────────────────

model SalaryPayment {
  id                 Int       @id @default(autoincrement())
  paymentDate        DateTime? // تاريخ الدفع
  sourceMonth        String? // شهر الاستحقاق (مثل Jun-25)
  transactionId      String    @unique // رقم العملية (مفتاح فريد)
  beneficiaryAccount String? // رقم حساب المستفيد
  beneficiaryName    String // اسم المستفيد
  bankName           String? // البنك
  amount             Float     @default(0) // المبلغ
  currency           String    @default("KWD") // العملة
  paymentType        String? // نوع الدفع
  status             String? // الحالة (PROCESSED ...)
  errorDescription   String? // وصف الخطأ
  civilId            String? // الرقم المدني
  duplicateFlag      String? // علامة التكرار

  createdAt DateTime @default(now())

  @@index([paymentDate])
  @@index([beneficiaryName])
  @@index([civilId])
  @@index([status])
  @@map("salary_payments")
}

// ─────────────────────────────────────────────────────────────────────────
//  استيراد كشف الحساب البنكي (Bank Statement Import)
// ─────────────────────────────────────────────────────────────────────────

model BankStatementImport {
  id           Int       @id @default(autoincrement())
  bankName     String    // 'NBK' | 'KFH' | 'GulfBank' | 'Boubyan' | 'Warba' | 'AhliUnited' | 'Unknown'
  fileName     String
  importedBy   String
  importedAt   DateTime  @default(now())
  fromDate     DateTime?
  toDate       DateTime?
  totalRows    Int       @default(0)
  totalDebits  Float     @default(0)
  totalCredits Float     @default(0)
  status       String    @default("ACTIVE") // ACTIVE | ARCHIVED

  transactions BankStatementTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bankName])
  @@index([status])
  @@index([importedAt])
  @@map("bank_statement_imports")
}

model BankStatementTransaction {
  id     Int                 @id @default(autoincrement())
  importId Int
  import BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  transactionId  String?
  bankName       String
  statementDate  DateTime?
  postingDate    DateTime?
  description    String    @default("")
  reference      String?
  debit          Float     @default(0)
  credit         Float     @default(0)
  balance        Float?
  currency       String    @default("KWD")
  accountNumber  String?
  iban           String?
  chequeNumber   String?
  rawRow         String    @default("{}") // JSON
  normalizedText String    @default("")

  // Reconciliation state
  reconcileStatus String  @default("UNMATCHED") // UNMATCHED | MATCHED | IGNORED | DUPLICATE | REVIEW
  matchedType     String? // 'invoice' | 'payment' | 'expense' | 'journal' | 'cheque' | 'payroll'
  matchedId       Int?
  matchedRef      String?
  matchConfidence Int?    // 100 | 90 | 75 | 0

  // Flags
  isDuplicate Boolean @default(false)
  isBankFee   Boolean @default(false)
  bankFeeType String? // 'TRANSFER_FEE' | 'MONTHLY_FEE' | 'INTEREST' | 'CHARGE' | 'OTHER'
  errors      String  @default("[]") // JSON array
  warnings    String  @default("[]") // JSON array

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importId])
  @@index([reconcileStatus])
  @@index([transactionId])
  @@index([chequeNumber])
  @@index([statementDate])
  @@map("bank_statement_transactions")
}

// ─────────────────────────────────────────────────────────────────────────
//  الأسعار الثابتة للمشاريع (Project Prices)
// ─────────────────────────────────────────────────────────────────────────

model ProjectPrice {
  id               Int     @id @default(autoincrement())
  asphaltPlant     String // مصنع الأسفلت
  companyName      String // اسم الشركة
  contractLocation String // مكان العقد
  contractUnit     String // وحدة العقد: طن | درب | يومية
  unitPrice        Float // سعر الوحدة (د.ك)
  validUntil       DateTime? // تاريخ انتهاء الاتفاقية (للتنبيه عند الاقتراب من الانتهاء)
  isArchived       Boolean @default(false)
  customerId       Int?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceItems     InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isArchived])
  @@index([asphaltPlant])
  @@index([companyName])
  @@index([customerId])
  @@map("project_prices")
}

// ─────────────────────────────────────────────────────────────────────────
//  الشيكات (Cheques)
// ─────────────────────────────────────────────────────────────────────────

model Cheque {
  id              Int       @id @default(autoincrement())
  chequeNumber    String    @unique
  chequeDate      DateTime
  beneficiaryName String
  amount          Float
  currency        String    @default("KWD")
  description     String?
  bankName        String
  templateName    String?
  status          String    @default("DRAFT") // DRAFT | PRINTED | CANCELLED
  printedAt       DateTime?
  cancelledAt     DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([chequeDate])
  @@index([beneficiaryName])
  @@map("cheques")
}
