# قاعدة البيانات (ملف SQLite محلي)
DATABASE_URL="file:./data/manar.db"

# الخدمة الخلفية — تستمع محليًا فقط
PORT=48211
HOST=127.0.0.1

# سر توقيع رموز الجلسة (يُولّد عشوائيًا عند أول تثبيت)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"

# مجلد النسخ الاحتياطي
BACKUP_DIR="./data/backups"

# مستوى التسجيل
LOG_LEVEL="info"

# بيئة التشغيل
NODE_ENV="development"
